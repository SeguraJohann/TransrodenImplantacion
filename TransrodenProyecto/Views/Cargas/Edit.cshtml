@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Carga

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">


    <h2>Editar Carga</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Id_Carga)

            <div class="form-group">
    @Html.LabelFor(model => model.Id_Usuario, "Id_Usuario", htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("Id_Usuario", null, htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Id_Usuario, "", new { @class = "text-danger" })
    </div>
</div>
<br>
<div class="form-group">
    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
    </div>
</div>

<!-- Campo oculto para NumeroPaquetes -->
@Html.HiddenFor(model => model.NumeroPaquetes)

<!-- Campo oculto para Estado -->
@Html.HiddenFor(model => model.Estado)

<!-- Campo oculto para Origen -->
@Html.HiddenFor(model => model.Origen)

<!-- Campo oculto para fecha_creacion -->
@Html.HiddenFor(model => model.fecha_creacion)
            <br>
            <div class="form-actions no-color">
                <input type="submit" value="Guardar" class="btn btn-success" />

                @if (Session["Usuario"] != null)
                {
                    // Obtener la sede del usuario desde la sesión
                    var sedeUsuario = Session["Sede"] != null ? (Sede)Session["Sede"] : Sede.SanJose; // Valor por defecto

                    // Determinar la URL según la sede
                    string urlCargas;
                    if (sedeUsuario == Sede.SanJose)
                    {
                        urlCargas = Url.Action("AsignarPaqueteSJCarga", "PaquetesCargasController");
                    }
                    else if (sedeUsuario == Sede.PerezZeledon)
                    {
                        urlCargas = Url.Action("AsignarPaquetePZCarga", "PaquetesCargasController");
                    }
                    else
                    {
                        urlCargas = "#"; // En caso de que la sede no sea válida, puedes redirigir a una página de error o similar.
                    }

                    // Enlace a Cargas
                    <a href="@urlCargas" class="btn btn-primary"> < Regresar</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Cuenta")" class="btn btn-danger">
                        <span class="d-block"><i class="fas fa-user"></i></span>
                        Login
                    </a>
                }
            </div>
        </div>




        <br>

    }


</div>
