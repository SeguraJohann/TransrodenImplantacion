@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Carga

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">


    <h3>Estas Seguro de eliminar esta Carga?</h3>
    <br>
    <div>
        <h4>Eliminar Carga</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.Usuario.Nombre)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Usuario.Nombre)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Descripcion)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.NumeroPaquetes)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.NumeroPaquetes)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Estado)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Estado)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.fecha_creacion)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.fecha_creacion)
            </dd>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Eliminar" class="btn btn-danger" />

                @if (Session["Usuario"] != null)
                {
                    // Obtener la sede del usuario desde la sesión
                    var sedeUsuario = Session["Sede"] != null ? (Sede)Session["Sede"] : Sede.SanJose; // Valor por defecto

                    // Determinar la URL según la sede
                    string urlCargas;
                    if (sedeUsuario == Sede.SanJose)
                    {
                        urlCargas = Url.Action("AsignarPaqueteSJCarga", "PaquetesCargasController");
                    }
                    else if (sedeUsuario == Sede.PerezZeledon)
                    {
                        urlCargas = Url.Action("AsignarPaquetePZCarga", "PaquetesCargasController");
                    }
                    else
                    {
                        urlCargas = "#"; // En caso de que la sede no sea válida, puedes redirigir a una página de error o similar.
                    }

                    // Enlace a Cargas
                    <a href="@urlCargas" class="btn btn-primary"> < Regresar</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Cuenta")" class="btn btn-danger">
                        <span class="d-block"><i class="fas fa-user"></i></span>
                        Login
                    </a>
                }
            </div>
        }
    </div>

</div>

