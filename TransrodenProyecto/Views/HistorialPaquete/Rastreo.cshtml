@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.HistorialPaqueteViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}






    <!-- Imagen de Banner -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Experiencia, Servicio y Calidad!</h4>
            <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                <li class="breadcrumb-item"><a href="index.html">Inicio</a></li>
                <li class="breadcrumb-item"><a href="#">Rastreo</a></li>
            </ol>
        </div>
    </div>



    @{
        var estadoDescripcion = new Dictionary<EstadoPaquete, string>
{
        { EstadoPaquete.SinAsignar, "Sin Asignar" },
        { EstadoPaquete.SinAsignarSJ, "En poder de Transroden San José" },
        { EstadoPaquete.SinAsignarPZ, "En poder de Transroden Perez Zeledón" },
        { EstadoPaquete.Asignado, "Asignado" },
        { EstadoPaquete.EnTransito, "El paquete se encuentra en ruta hacia la bodega de destino" },
        { EstadoPaquete.BodegaPZ, "El paquete está en la Bodega de Transroden Perez Zeledón para el retiro o en ruta para ser entregado por un mensajero. Recuerde presentar su identificación." },
        { EstadoPaquete.BodegaSJ, "El paquete está en la Bodega de Transroden San José para el retiro o en ruta para ser entregado por un mensajero. Recuerde presentar su identificación." },
        { EstadoPaquete.Domicilio, "El paquete se encuentra en ruta para ser entregado domicilio" },
        { EstadoPaquete.Entregado, "El paquete ha sido entregado" },
        { EstadoPaquete.NoEntregado, "El paquete no pudo ser entregado, por favor contactanos para coordinar su reenvio o ve a la sucursal de tu conveniencia." },
        { EstadoPaquete.Reenvio, "El paquete esta siendo preparado para su reenvio" }
    };
    }


    <div class="container mt-5">
        <h2 class="text-center">Rastreo de paquete</h2>
        <br>

        <form method="get" action="@Url.Action("Rastreo")">
            <div class="form-group">
                <label for="numeroRastreo">Ingresa el Número de Rastreo:</label>
                <br>
                <br>
                <input type="text" name="numeroRastreo" id="numeroRastreo" class="form-control" placeholder="número de rastreo" />
            </div>
            <br>
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>

        <br />
        <br>
        @{
            if (Model.Paquete != null)
            {

                <div>
                    <p><strong>Número de Rastreo:</strong> @Model.Paquete.NumeroRastreo</p>
                    <p><strong>Nombre Emisor:</strong> @Model.Paquete.NombreEmisor</p>
                    <p><strong>Nombre Receptor:</strong> @Model.Paquete.NombreReceptor</p>
                    <p><strong>Dirección:</strong> @Model.Paquete.Direccion</p>

                </div>
                <br />

                <h3>Historial de Rastreo</h3>
                <br>

                if (Model.Historial != null && Model.Historial.Any())
                {


                    <table class="table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Historial)
                            {
                                <tr>
                                    <td>@item.Fecha</td>
                                    <td>@estadoDescripcion[item.Estado]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No se encontraron registros de rastreo para este paquete.</p>
                }
            }
        }

    </div>

