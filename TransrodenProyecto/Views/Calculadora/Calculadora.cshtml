@model TransrodenProyecto.ViewModels.CalculadoraViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <h2 class="text-center">Presupuestar un Envio</h2>
    <br>
    <p class="mb-0 text-center">
        Esta es una calculadora donde puedes conocer el <strong>Aproximado</strong> de un envio utilizando nuestros servicios
    </p>

    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5">
        <!-- Padding exterior de la caja login -->
        <div class="row justify-content-center w-100">
            <!-- Ancho de la caja login -->
            <div class="col-lg-6 col-md-7">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">

                    <form action="@Url.Action("Calculadora", "Calculadora")" method="post">
                        <div>
                            <br>
                            <label for="tipoCaja">Tamaño de la caja:</label>
                            <select id="tipoCaja" name="Id_Caja" class="form-control">
                                @foreach (var item in Model.TiposCaja)
                                {
                                    <option value="@item.Value" @(item.Value == Model.Id_Caja.ToString() ? "selected" : "")>@item.Text</option>
                                }
                            </select>
                        </div>
                        <br>
                        <div>
                            <label for="cantidad">Cantidad:</label>
                            <input type="number" id="cantidad" name="Cantidad" class="form-control" value="@Model.Cantidad" min="1" />
                        </div>
                        <br>
                        <div>
                            <label for="domicilio">Entrega a Domicilio:</label>
                            <input type="checkbox" id="domicilio" name="Domicilio" value="true" @(Model.Domicilio ? "checked" : "") />
                        </div>
                        <br>
                        <div>
                            <label for="tipoEntrega">Tipo de Entrega:</label>
                            <select id="tipoEntrega" name="Id_Entrega" class="form-control">
                                @foreach (var item in Model.TiposEntrega)
                                {
                                    <option value="@item.Value" @(item.Value == Model.Id_Entrega.ToString() ? "selected" : "")>@item.Text</option>
                                }
                            </select>
                        </div>
                        <br>
                        <div>
                            <button type="submit" class="btn btn-primary">Calcular</button>
                        </div>

                        @if (Model.CostoTotal > 0)
                        {
                            <div class="alert alert-success mt-3">
                                <strong>Costo Total:</strong> ₡@Model.CostoTotal
                            </div>
                            <br>
                            <p class="mb-0 text-center">
                                Nota: Los precios pueden variar una vez se realize el tramite en nuestras sucursales!!
                            </p>
                        }
                    </form>




                </div>
            </div>
        </div>
    </div>
</div>

