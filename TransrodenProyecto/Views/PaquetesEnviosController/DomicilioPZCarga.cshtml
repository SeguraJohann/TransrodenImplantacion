@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteEnvioViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>


<div class="container-fluid bg-light py-4">
    <!-- Header Section -->
    <div class="text-center mb-4">
        <h1 class="display-4 mb-4">Envíos Domicilios Perez Zeledón</h1>
        <a href="@Url.Action("VistaCargaTransito", "PaquetesCargas")" class="btn btn-primary">
            <i class="fa fa-truck me-2"></i> Ver cargas en Tránsito
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-box me-2"></i>Paquetes Sin Envío Asignado
                    </h3>
                    <div class="form-inline">
                        <label class="mr-2">Mostrar:</label>
                        <select class="form-control form-control-sm" onchange="changePageSize(this.value)">
                            <option value="5" @(Model.PageSize == 5 ? "selected" : "")>5</option>
                            <option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</option>
                            <option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</option>
                            <option value="50" @(Model.PageSize == 50 ? "selected" : "")>50</option>
                        </select>
                    </div>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <strong>Éxito:</strong> @TempData["SuccessMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card-body">
                    @using (Html.BeginForm("AsignarPaqueteAEnvioPZ", "PaquetesEnviosController", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Número de Rastreo</th>
                                        <th>Emisor</th>
                                        <th>Receptor</th>
                                        <th>Estado</th>
                                        <th>Asignar a Envío</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Paquetes.Any())
                                    {
                                        for (int i = 0; i < Model.Paquetes.Count; i++)
                                        {
                                            var paquete = Model.Paquetes[i];
                                            <tr>
                                                <td><span class="badge" style="background-color: var(--bg-info); color: white;">@paquete.NumeroRastreo</span></td>
                                                <td>@paquete.NombreEmisor</td>
                                                <td>@paquete.NombreReceptor</td>
                                                <td><span class="badge" style="background-color: var(--bg-info);">@paquete.Estado.ToString()</span></td>
                                                <td>
                                                    @Html.Hidden($"PaqueteEnvioAsignaciones[{i}].IdPaquete", paquete.Id_Paquete)
                                                    <select name="PaqueteEnvioAsignaciones[@i].IdEnvio" class="form-select form-select-sm">
                                                        <option value="">Seleccionar Envío</option>
                                                        @foreach (var envio in Model.Envios)
                                                        {
                                                            <option value="@envio.Id_Envio">
                                                                Envío: @envio.Id_Envio - Usuario: @envio.Usuario.Nombre
                                                            </option>
                                                        }
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                No hay paquetes sin asignar
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <span>Mostrando @((Model.PaquetePageNumber - 1) * Model.PageSize + 1) a @Math.Min(Model.PaquetePageNumber * Model.PageSize, Model.PaqueteTotalCount) de @Model.PaqueteTotalCount registros</span>
                                </div>
                                <div class="col-md-6">
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-end mb-0">
                                            <li class="page-item @(Model.PaquetePageNumber == 1 ? "disabled" : "")">
                                                <a class="page-link" href="@Url.Action("DomicilioPZCarga", new {
                                                    paquetePage = Model.PaquetePageNumber - 1,
                                                    envioPage = Model.EnvioPageNumber,
                                                    pageSize = Model.PageSize
                                                })">Anterior</a>
                                            </li>

                                            @for (int i = 1; i <= Model.PaqueteTotalPages; i++)
                                            {
                                                <li class="page-item @(i == Model.PaquetePageNumber ? "active" : "")">
                                                    <a class="page-link" href="@Url.Action("DomicilioPZCarga", new {
                                                        paquetePage = i,
                                                        envioPage = Model.EnvioPageNumber,
                                                        pageSize = Model.PageSize
                                                    })">@i</a>
                                                </li>
                                            }

                                            <li class="page-item @(Model.PaquetePageNumber == Model.PaqueteTotalPages ? "disabled" : "")">
                                                <a class="page-link" href="@Url.Action("DomicilioPZCarga", new {
                                                    paquetePage = Model.PaquetePageNumber + 1,
                                                    envioPage = Model.EnvioPageNumber,
                                                    pageSize = Model.PageSize
                                                })">Siguiente</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>

                        if (Model.Paquetes.Any())
                        {
                            <div class="text-end mt-3">
                                <button type="submit" class="btn" style="background-color: var(--bg-positivo); color: white;">
                                    <i class="fa fa-save me-2"></i>Asignar Envío
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>


        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-truck-loading me-2"></i>Carga Envío Domicilio
                    </h3>
                    <a href="@Url.Action("Create", "Envios")" class="btn" style="background-color: var(--bg-positivo); color: white;">
                        <i class="fas fa-plus me-2"></i>Agregar Envío
                    </a>
                </div>

                @if (TempData["ErrorMessageCarga"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessageCarga"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessageCarga"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <strong>Éxito:</strong> @TempData["SuccessMessageCarga"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Transportista</th>
                                    <th>Estado</th>
                                    <th>Paquetes</th>
                                    <th>Acciones</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var envio in Model.Envios)
                                {
                                    <tr>
                                        <td><span class="badge" style="background-color: var(--bg-info); color: white;">@envio.Id_Envio</span></td>
                                        <td>@envio.Usuario.Nombre</td>
                                        <td><span class="badge" style="background-color: var(--bg-dark); color: white;">@envio.Estado.ToString()</span></td>
                                        <td>
                                            <span class="badge" style="background-color: var(--bg-info); color: white;">@envio.NumeroPaquetes</span>
                                            <a href="@Url.Action("EnvioPaquetes", "PaquetesEnviosController", new { idEnvio = envio.Id_Envio })"
                                               class="btn btn-sm btn-outline-primary ms-2">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="@Url.Action("Edit", "Envios", new { id = envio.Id_Envio })"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", "Envios", new { id = envio.Id_Envio })"
                                                   class="btn btn-sm" style="background-color: var(--bg-negativo); color: white;">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td>
                                            @using (Html.BeginForm("ActualizarEstadoEnvioPZ", "PaquetesEnviosController", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("idEnvio", envio.Id_Envio)
                                                <div class="input-group input-group-sm">
                                                    <select name="nuevoEstado" class="form-select">
                                                        <option value="">Estado</option>
                                                        <option value="EnTransito">EnTransito</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-secondary">
                                                        <i class="fa fa-sync-alt"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span>Mostrando @((Model.EnvioPageNumber - 1) * Model.PageSize + 1) a @Math.Min(Model.EnvioPageNumber * Model.PageSize, Model.EnvioTotalCount) de @Model.EnvioTotalCount registros</span>
                            </div>
                            <div class="col-md-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-end mb-0">
                                        <li class="page-item @(Model.EnvioPageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("DomicilioPZCarga", new {
                                                envioPage = Model.EnvioPageNumber - 1,
                                                paquetePage = Model.PaquetePageNumber,
                                                pageSize = Model.PageSize
                                            })">Anterior</a>
                                        </li>

                                        @for (int i = 1; i <= Model.EnvioTotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.EnvioPageNumber ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("DomicilioPZCarga", new {
                                                    envioPage = i,
                                                    paquetePage = Model.PaquetePageNumber,
                                                    pageSize = Model.PageSize
                                                })">@i</a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.EnvioPageNumber == Model.EnvioTotalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("DomicilioPZCarga", new {
                                                envioPage = Model.EnvioPageNumber + 1,
                                                paquetePage = Model.PaquetePageNumber,
                                                pageSize = Model.PageSize
                                            })">Siguiente</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changePageSize(size) {
        window.location.href = '@Url.Action("DomicilioPZCarga")' +
            '?paquetePage=@Model.PaquetePageNumber' +
            '&envioPage=@Model.EnvioPageNumber' +
            '&pageSize=' + size;
    }
</script>