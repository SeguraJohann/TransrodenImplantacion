@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteEnvioViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid bg-light py-4">
    <!-- Header Section -->
    <div class="text-center mb-4">
        <h1 class="display-4 mb-4">Envíos Domicilios Perez Zeledón</h1>
        <a href="@Url.Action("VistaCargaTransito", "PaquetesCargasController")" class="btn btn-primary">
            <i class="fa fa-truck me-2"></i> Ver cargas en Tránsito
        </a>
    </div>

    <div class="row g-4">
        <!-- Packages Section - First Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-box me-2"></i>Paquetes Sin Envío Asignado
                    </h3>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("AsignarPaqueteAEnvioPZ", "PaquetesEnviosController", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Número de Rastreo</th>
                                        <th>Emisor</th>
                                        <th>Receptor</th>
                                        <th>Estado</th>
                                        <th>Asignar a Envío</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Paquetes.Count; i++)
                                    {
                                        var paquete = Model.Paquetes[i];
                                        <tr>
                                            <td><span class="badge" style="background-color: var(--bg-info); color: white;">@paquete.NumeroRastreo</span></td>
                                            <td>@paquete.NombreEmisor</td>
                                            <td>@paquete.NombreReceptor</td>
                                            <td><span class="badge" style="background-color: var(--bg-info);">@paquete.Estado.ToString()</span></td>
                                            <td>
                                                @Html.Hidden($"PaqueteEnvioAsignaciones[{i}].IdPaquete", paquete.Id_Paquete)
                                                <select name="PaqueteEnvioAsignaciones[@i].IdEnvio" class="form-select form-select-sm">
                                                    <option value="">Seleccionar Envío</option>
                                                    @foreach (var envio in Model.Envios)
                                                    {
                                                        <option value="@envio.Id_Envio">
                                                            Envío: @envio.Id_Envio - Usuario: @envio.Usuario.Nombre
                                                        </option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-end mt-3">
                            <button type="submit" class="btn" style="background-color: var(--bg-positivo); color: white;">
                                <i class="fa fa-save me-2"></i>Asignar Envío
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Active Shipments Section - Second Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-truck-loading me-2"></i>Envíos Activos
                    </h3>
                    <a href="@Url.Action("Create", "Envios")" class="btn btn-positivo" style="color: white;">
                        <i class="fas fa-plus me-2"></i>Agregar Envío
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Transportista</th>
                                    <th>Estado</th>
                                    <th>Paquetes</th>
                                    <th>Acciones</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var envio in Model.Envios)
                                {
                                    <tr>
                                        <td><span class="badge" style="background-color: var(--bg-info); color: white;">@envio.Id_Envio</span></td>
                                        <td>@envio.Usuario.Nombre</td>
                                        <td><span class="badge" style="background-color: var(--bg-dark); color: white;">@envio.Estado.ToString()</span></td>
                                        <td>
                                            <span class="badge" style="background-color: var(--bg-info); color: white;">@envio.NumeroPaquetes</span>
                                            <a href="@Url.Action("EnvioPaquetes", "PaquetesEnviosController", new { idEnvio = envio.Id_Envio })"
                                               class="btn btn-sm btn-outline-primary ms-2">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="@Url.Action("Edit", "Envios", new { id = envio.Id_Envio })"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", "Envios", new { id = envio.Id_Envio })"
                                                   class="btn btn-sm" style="background-color: var(--bg-negativo); color: white;">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td>
                                            @using (Html.BeginForm("ActualizarEstadoEnvioPZ", "PaquetesEnviosController", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("idEnvio", envio.Id_Envio)
                                                <div class="input-group input-group-sm">
                                                    <select name="nuevoEstado" class="form-select">
                                                        <option value="">Estado</option>
                                                        <option value="BodegaPZ">BodegaPZ</option>
                                                        <option value="EnTransito">EnTransito</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-secondary">
                                                        <i class="fa fa-sync-alt"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>