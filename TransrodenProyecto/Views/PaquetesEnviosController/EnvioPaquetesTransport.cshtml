@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteEnvioViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalRecords = (int)ViewBag.TotalRecords;
    var searchTracking = ViewBag.SearchTracking as string;
    var searchCedula = ViewBag.SearchCedula as string;
    var searchEstado = ViewBag.SearchEstado as EstadoPaquete?;
    var estadosPaquete = ViewBag.EstadosPaquete as List<EstadoPaquete>;
    var idEnvio = ViewBag.IdEnvio;
}


<div class="container mt-5">
    <h2 class="text-center">Paquetes del Envío</h2>
    <br>
    <h4>Transportista: @Model.Envios.First().Usuario.Nombre</h4>
    <h4>Estado: @Model.Envios.First().Estado.ToString()</h4>
    <h4>Paquetes Asignados: @Model.Envios.First().NumeroPaquetes</h4>
    <br>
    <br>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="input-group mb-3">
                <input type="text" id="searchTracking" class="form-control" placeholder="Número de rastreo" value="@searchTracking">
                <button id="searchTrackingButton" class="btn btn-primary search-button">Buscar</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-group mb-3">
                <input type="text" id="searchCedula" class="form-control" placeholder="Cédula receptor" value="@searchCedula">
                <button id="searchCedulaButton" class="btn btn-primary search-button">Buscar</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-group mb-3">
                <select id="searchEstado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="Domicilio" @(searchEstado.HasValue && searchEstado.Value == EstadoPaquete.Domicilio ? "selected" : "")>Domicilio</option>
                    <option value="Entregado" @(searchEstado.HasValue && searchEstado.Value == EstadoPaquete.Entregado ? "selected" : "")>Entregado</option>
                    <option value="NoEntregado" @(searchEstado.HasValue && searchEstado.Value == EstadoPaquete.NoEntregado ? "selected" : "")>No Entregado</option>
                </select>
                <button id="searchEstadoButton" class="btn btn-primary search-button">Filtrar</button>
                @if (!string.IsNullOrEmpty(searchTracking) || !string.IsNullOrEmpty(searchCedula) || searchEstado.HasValue)
                {
                    <button id="clearButton" class="btn btn-secondary">Limpiar</button>
                }
            </div>
        </div>
    </div>


    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted small">
            Mostrando página @currentPage de @totalPages - Total: @totalRecords registros
        </div>
    </div>

    <table class="table mt-4">
        <thead>
            <tr>
                <th>Número de Rastreo</th>
                <th>Estado</th>
                <th>Receptor</th>
                <th>Cédula del Receptor</th>
                <th>Dirección</th>
                <th>Pago</th>
                <th>Detalles</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Paquetes.Any())
            {
                foreach (var paquete in Model.Paquetes)
                {
                    <tr>
                        <td style="color: #000000; font-weight: bold;">@paquete.NumeroRastreo</td>
                        <td style="color: #000000; font-weight: bold;">@paquete.Estado.ToString()</td>
                        <td>@paquete.NombreReceptor</td>
                        <td>@paquete.CedulaReceptor</td>
                        <td>@paquete.Direccion</td>
                        <td style="color: #000000; font-weight: bold;">
                            @if (paquete.Pago)
                            {
                                <i class="fas fa-check text-success"></i>
                            }
                            else
                            {
                                <i class="far fa-times-circle text-danger"></i>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("DetailsTransp", "Paquetes", new { id = paquete.Id_Paquete })" class="btn btn-primary">
                                Ver
                            </a>
                        </td>
                        <td>
                            <form method="post" action="@Url.Action("ActualizarEstadoPaquete", "PaquetesEnviosController")" id="form-estado-@paquete.Id_Paquete">
                                @Html.AntiForgeryToken()
                                @Html.Hidden("idPaquete", paquete.Id_Paquete)

                                <select name="nuevoEstado" class="form-control" onchange="handleEstadoChange(this, @paquete.Id_Paquete, '@paquete.CedulaReceptor')">
                                    <option value="">Estado</option>
                                    <option value="Domicilio">En Tránsito</option>
                                    <option value="Entregado">Entregado</option>
                                    <option value="NoEntregado">No Entregado</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No se encontraron paquetes</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Paginacion -->
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="/PaquetesEnviosController/EnvioPaquetesTransport/@idEnvio?page=@(currentPage - 1)&searchTracking=@searchTracking&searchCedula=@searchCedula&searchEstado=@searchEstado">
                            &laquo; Anterior
                        </a>
                    </li>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="/PaquetesEnviosController/EnvioPaquetesTransport/@idEnvio?page=@i&searchTracking=@searchTracking&searchCedula=@searchCedula&searchEstado=@searchEstado">
                            @i
                        </a>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="/PaquetesEnviosController/EnvioPaquetesTransport/@idEnvio?page=@(currentPage + 1)&searchTracking=@searchTracking&searchCedula=@searchCedula&searchEstado=@searchEstado">
                            Siguiente &raquo;
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

    <!-- Modal para confirmar entrega -->
    <div class="modal fade" id="cedulaModal" tabindex="-1" aria-labelledby="cedulaModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="modalForm" method="post" action="@Url.Action("ActualizarEstadoPaquete", "PaquetesEnviosController")">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="cedulaModalLabel">Confirmar Entrega</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="modalIdPaquete" name="idPaquete" />
                        <input type="hidden" id="modalEstado" name="nuevoEstado" />
                        <div class="mb-3">
                            <label for="modalCedula" class="form-label">Ingrese la Cédula del Receptor</label>
                            <input type="text" class="form-control" id="modalCedula" name="cedulaReceptor" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <a href="@Url.Action("EnviosTransportista", "PaquetesEnviosController")" class="btn btn-success">
        Regresar
    </a>
</div>
<br>

@section Scripts {
    <script>
        $(document).ready(function() {

            var idEnvio = @idEnvio;

            function buildUrlWithParams(page) {
                var url = '@Url.Action("EnvioPaquetesTransport", "PaquetesEnviosController", new { idEnvio = "_idEnvio_" })'
                    .replace('_idEnvio_', idEnvio);

                var params = [];
                var searchTracking = $('#searchTracking').val();
                var searchCedula = $('#searchCedula').val();
                var searchEstado = $('#searchEstado').val();

                if (searchTracking) params.push('searchTracking=' + encodeURIComponent(searchTracking));
                if (searchCedula) params.push('searchCedula=' + encodeURIComponent(searchCedula));
                if (searchEstado) params.push('searchEstado=' + encodeURIComponent(searchEstado));

                params.push('page=' + page);

                return url + (params.length > 0 ? '&' + params.join('&') : '');
            }

            $('.search-button').on('click', function() {
                window.location.href = buildUrlWithParams(1);
            });

            // Limpiar busqueda
            $('#clearButton').on('click', function() {
                window.location.href = '@Url.Action("EnvioPaquetesTransport", "PaquetesEnviosController", new { idEnvio = "_idEnvio_" })'
                    .replace('_idEnvio_', idEnvio);
            });

            $('#searchTracking, #searchCedula').keypress(function(e) {
                if (e.which == 13) {
                    window.location.href = buildUrlWithParams(1);
                }
            });

            // Para el cambio de estado
            window.handleEstadoChange = function(select, idPaquete, cedulaReceptor) {
                if (select.value === "Entregado") {
                    const modal = new bootstrap.Modal(document.getElementById('cedulaModal'));
                    document.getElementById('modalIdPaquete').value = idPaquete;
                    document.getElementById('modalEstado').value = select.value;
                    document.getElementById('modalCedula').value = '';
                    modal.show();
                } else if (select.value) {
                    document.getElementById(`form-estado-${idPaquete}`).submit();
                }
            };
        });
    </script>
}
