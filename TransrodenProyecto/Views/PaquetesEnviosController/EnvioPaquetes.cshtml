        <script>
        function goBack() {
            if (document.referrer) {
                window.history.back();
            } else {
                @*window.location.href = '@Url.Action("DefaultAction", "DefaultController")';*@
                if (sedeUsuario == Sede.SanJose) {
                    urlEnvios = Url.Action("DomicilioSJCarga", "PaquetesEnviosController");
                }
                else if (sedeUsuario == Sede.PerezZeledon) {
                    urlEnvios = Url.Action("DomicilioPZCarga", "PaquetesEnviosController");
                }
                else {
                    urlEnvios = "#";
                }
            }
        }
        </script>
    }
    else
