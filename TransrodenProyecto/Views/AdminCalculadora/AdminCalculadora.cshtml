@model TransrodenProyecto.ViewModels.AdminCalculadoraViewModel
@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5 login-container">
        <div class="row justify-content-center w-100">
            <div class="col-12">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                    <div class="text-center mb-4">
                        <h2>Panel de Administración de Calculadora</h2>
                    </div>

                    <!-- Sección de Cajas -->
                    <div class="card mb-4">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">Cajas</h4>
                            <a href="@Url.Action("Create", "CalcCajas")" class="btn btn-positivo btn-sm">
                                <i class="fas fa-plus-circle me-2"></i>Crear
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Tipo</th>
                                            <th>Costo</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Caja)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Costo)</td>
                                                <td class="text-end">
                                                    <a href="@Url.Action("Edit", "CalcCajas", new { id = item.Id_Caja })" class="btn btn-icon btn-edit" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", "CalcCajas", new { id = item.Id_Caja })" class="btn btn-icon btn-delete" title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Entregas -->
                    <div class="card mb-4">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">Entregas</h4>
                            <a href="@Url.Action("Create", "CalcEntregas")" class="btn btn-positivo btn-sm">
                                <i class="fas fa-plus-circle me-2"></i>Crear
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Tipo</th>
                                            <th>Tarifa</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Entrega)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Tarifa)</td>
                                                <td class="text-end">
                                                    <a href="@Url.Action("Edit", "CalcEntregas", new { id = item.Id_Entrega })" class="btn btn-icon btn-edit" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", "CalcEntregas", new { id = item.Id_Entrega })" class="btn btn-icon btn-delete" title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Domicilios -->
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">Domicilios</h4>
                            <a href="@Url.Action("Create", "CalcDomicilios")" class="btn btn-positivo btn-sm">
                                <i class="fas fa-plus-circle me-2"></i>Crear
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Tipo</th>
                                            <th>Costo</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Domicilio)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Costo)</td>
                                                <td class="text-end">
                                                    <a href="@Url.Action("Edit", "CalcDomicilios", new { id = item.Id_Domicilio })" class="btn btn-icon btn-edit" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", "CalcDomicilios", new { id = item.Id_Domicilio })" class="btn btn-icon btn-delete" title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>