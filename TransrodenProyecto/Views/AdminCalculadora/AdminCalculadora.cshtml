@model TransrodenProyecto.ViewModels.AdminCalculadoraViewModel
@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container mt-5">

    <h2 class="text-center">Panel de Administración de Calculadora</h2>
    <br>
    <h3>Cajas</h3>
    <p>
        <a href="@Url.Action("Create", "CalcCajas")" class="btn btn-success btn-sm">Crear</a>
    </p>
    <table class="table">
        <tr>
            <th>
                Tipo
            </th>
            <th>
                Costo
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model.Caja)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Costo)
                </td>
                <td>
                    <a href="@Url.Action("Edit", "CalcCajas", new { id = item.Id_Caja })" class="btn btn-primary btn-sm">Editar</a> |
                    <!--<a href="@Url.Action("Details", "CalcCajas", new { id = item.Id_Caja })" class="btn btn-warning btn-sm">Detalles</a> |-->
                    <a href="@Url.Action("Delete", "CalcCajas", new { id = item.Id_Caja })" class="btn btn-danger btn-sm">Delete</a>
                </td>



            </tr>
        }
    </table>

    <br>
    <h3>Entregas</h3>
    <p>
        <a href="@Url.Action("Create", "CalcEntregas")" class="btn btn-success btn-sm">Crear</a>
    </p>
    <table class="table">
        <tr>
            <th>
                Tipo
            </th>
            <th>
                Tarifa
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model.Entrega)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tarifa)
                </td>
                <td>
                    <a href="@Url.Action("Edit", "CalcEntregas", new { id = item.Id_Entrega  })" class="btn btn-primary btn-sm">Editar</a> |
                    <!-- <a href="@Url.Action("Details", "CalcEntregas", new { id = item.Id_Entrega  })" class="btn btn-warning btn-sm">Detalles</a> |-->
                    <a href="@Url.Action("Delete", "CalcEntregas", new { id = item.Id_Entrega  })" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }

    </table>



    <br>
    <h3>Domicilios</h3>
    <p>
        <a href="@Url.Action("Create", "CalcDomicilios")" class="btn btn-success btn-sm">Crear</a>
    </p>
    <table class="table">
        <tr>
            <th>
                Tipo
            </th>
            <th>
                Costo
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model.Domicilio)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Costo)
                </td>
                <td>
                    <a href="@Url.Action("Edit", "CalcDomicilios", new { id = item.Id_Domicilio  })" class="btn btn-primary btn-sm">Editar</a> |
                    <!--<a href="@Url.Action("Details", "CalcDomicilios", new { id = item.Id_Domicilio  })" class="btn btn-warning btn-sm">Detalles</a> | -->
                    <a href="@Url.Action("Delete", "CalcDomicilios", new { id = item.Id_Domicilio  })" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }

    </table>

</div>
