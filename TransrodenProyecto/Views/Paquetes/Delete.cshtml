@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Paquete


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container py-5 login-container">
        <div class="bg-white rounded shadow-sm p-4">
            <div class="card-header bg-danger text-white rounded-top">
                <h2 class="text-center mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Confirmar Eliminación
                </h2>
            </div>

            <div class="card-body">
                <div class="alert alert-warning mb-4">
                    <h4 class="alert-heading mb-3">
                        <i class="fas fa-question-circle me-2"></i>
                        ¿Está seguro de eliminar este paquete?
                    </h4>
                    <p class="mb-0">Esta acción no se puede deshacer. Por favor, revise los detalles antes de confirmar.</p>
                </div>

                <div class="row g-4">
                    <!-- Información de Rastreo y Referencias -->
                    <div class="col-12">
                        <div class="bg-light rounded p-3">
                            <div class="row">
                                <div class="col-md-4">
                                    <h5 class="text-primary">Número de Rastreo</h5>
                                    <p class="h4">@Html.DisplayFor(model => model.NumeroRastreo)</p>
                                </div>
                                <div class="col-md-4">
                                    <h5 class="text-primary">ID Carga</h5>
                                    <p>@Html.DisplayFor(model => model.Carga.Id_Carga)</p>
                                </div>
                                <div class="col-md-4">
                                    <h5 class="text-primary">ID Envío</h5>
                                    <p>@Html.DisplayFor(model => model.Envio.Id_Envio)</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del Paquete -->
                    <div class="col-md-6">
                        <div class="bg-white border rounded h-100">
                            <div class="bg-light p-3 border-bottom">
                                <h5 class="mb-0">
                                    <i class="fas fa-box me-2"></i>
                                    Detalles del Paquete
                                </h5>
                            </div>
                            <div class="p-3">
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <label class="fw-bold">Tipo de Cliente</label>
                                        <p>@Html.DisplayFor(model => model.Cliente)</p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="fw-bold">Tipo de Paquete</label>
                                        <p>@Html.DisplayFor(model => model.Tipo)</p>
                                    </div>
                                    <div class="col-12">
                                        <label class="fw-bold">Descripción</label>
                                        <p>@Html.DisplayFor(model => model.Descripcion)</p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="fw-bold">Fecha Recibo</label>
                                        <p>@Html.DisplayFor(model => model.fecha_recibo)</p>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="fw-bold">Fecha Entrega</label>
                                        <p>@Html.DisplayFor(model => model.fecha_entrega)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información de Contacto -->
                    <div class="col-md-6">
                        <div class="bg-white border rounded h-100">
                            <div class="bg-light p-3 border-bottom">
                                <h5 class="mb-0">
                                    <i class="fas fa-users me-2"></i>
                                    Información de Contacto
                                </h5>
                            </div>
                            <div class="p-3">
                                <div class="mb-4">
                                    <h6 class="text-primary">Emisor</h6>
                                    <div class="ps-3">
                                        <p class="mb-1"><strong>Nombre:</strong> @Html.DisplayFor(model => model.NombreEmisor)</p>
                                        <p class="mb-3"><strong>Cédula:</strong> @Html.DisplayFor(model => model.CedulaEmisor)</p>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <h6 class="text-primary">Receptor</h6>
                                    <div class="ps-3">
                                        <p class="mb-1"><strong>Nombre:</strong> @Html.DisplayFor(model => model.NombreReceptor)</p>
                                        <p class="mb-1"><strong>Cédula:</strong> @Html.DisplayFor(model => model.CedulaReceptor)</p>
                                        @if (Model.Domicilio)
                                        {
                                            <p class="mb-1"><strong>Dirección:</strong> @Html.DisplayFor(model => model.Direccion)</p>
                                            <p class="mb-0"><strong>Teléfono:</strong> @Html.DisplayFor(model => model.TelefonoDomicilio)</p>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="d-flex align-items-center">
                                            <span class="badge @(Model.Domicilio ? "bg-success" : "bg-danger") me-2">
                                                <i class="fas @(Model.Domicilio ? "fa-check" : "fa-times") me-1"></i>
                                                Entrega a Domicilio
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex align-items-center">
                                            <span class="badge @(Model.Pago ? "bg-success" : "bg-danger") me-2">
                                                <i class="fas @(Model.Pago ? "fa-check" : "fa-times") me-1"></i>
                                                Pago Realizado
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="row mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-danger btn-lg me-2">
                                <i class="fas fa-trash-alt me-2"></i>
                                Confirmar Eliminación
                            </button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-positivo btn-lg" })
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
