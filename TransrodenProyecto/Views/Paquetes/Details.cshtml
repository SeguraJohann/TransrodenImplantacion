@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Paquete

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Detalles del Paquete</h2>
            <span class="badge bg-primary fs-5">@Html.DisplayFor(model => model.Estado)</span>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <!-- Información Principal -->
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-box me-2"></i>Información del Paquete
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <div class="alert alert-info">
                                        <strong>Número de Rastreo:</strong><br>
                                        @Html.DisplayFor(model => model.NumeroRastreo)
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="fw-bold">Tipo de Cliente</label>
                                    <p>@Html.DisplayFor(model => model.Cliente)</p>
                                </div>
                                <div class="col-sm-6">
                                    <label class="fw-bold">Tipo de Paquete</label>
                                    <p>@Html.DisplayFor(model => model.Tipo)</p>
                                </div>
                                <div class="col-sm-6">
                                    <label class="fw-bold">Origen</label>
                                    <p>@Html.DisplayFor(model => model.Origen)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información de Entrega -->
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-truck me-2"></i>Información de Entrega
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge @(Model.Domicilio ? "bg-success" : "bg-danger") me-2 fs-5 ">
                                        <i class="fas @(Model.Domicilio ? "fa-check" : "fa-times") me-1"></i>
                                        Entrega a Domicilio
                                    </span>
                                </div>
                                @if (Model.Domicilio)
                                {
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <p class="mb-1"><strong>Dirección:</strong> @Html.DisplayFor(model => model.Direccion)</p>
                                            <p class="mb-0"><strong>Teléfono:</strong> @Html.DisplayFor(model => model.TelefonoDomicilio)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información del Emisor y Receptor -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-users me-2"></i>Información de Contacto
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card bg-light mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-primary">Emisor</h6>
                                            <p class="mb-1"><strong>Nombre:</strong> @Html.DisplayFor(model => model.NombreEmisor)</p>
                                            <p class="mb-0"><strong>Cédula:</strong> @Html.DisplayFor(model => model.CedulaEmisor)</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title text-primary">Receptor</h6>
                                            <p class="mb-1"><strong>Nombre:</strong> @Html.DisplayFor(model => model.NombreReceptor)</p>
                                            <p class="mb-0"><strong>Cédula:</strong> @Html.DisplayFor(model => model.CedulaReceptor)</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br>
            @if (Session["Usuario"] != null)
            {
                // Enlace para regresar a la vista anterior
                <a href="javascript:void(0);" onclick="goBack()" class="btn btn-success">Regresar</a>
                <script>
function goBack() {
    if (document.referrer) {
        window.history.back();
    } else {
        @*window.location.href = '@Url.Action("DefaultAction", "DefaultController")';*@
        if (sedeUsuario == Sede.SanJose) {
            urlEnvios = Url.Action("DomicilioSJCarga", "PaquetesEnviosController");
        }
        else if (sedeUsuario == Sede.PerezZeledon) {
            urlEnvios = Url.Action("DomicilioPZCarga", "PaquetesEnviosController");
        }
        else {
            urlEnvios = "#";
        }
    }
}
                </script>
            }
            else
            {
                <a href="@Url.Action("Login", "Cuenta")" class="btn btn-danger">
                    <span class="d-block"><i class="fas fa-user"></i></span>
                    Login
                </a>
            }

            <!-- Botones de Acción -->
            @*<div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-center gap-2">
                    @Html.ActionLink("Editar", "Edit", new { id = Model.Id_Paquete }, new { @class = "btn btn-positivo d-flex align-items-center" })
                    @Html.ActionLink("Regresar a la lista", "Index", null, new { @class = "btn btn-primary d-flex align-items-center justify-content-center" })
                </div>
            </div>
        </div>*@
        </div>
    </div>
</div>