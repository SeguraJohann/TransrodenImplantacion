@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Paquete


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container mt-5">
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h4 class="text-center mb-0">Registro de Paquete</h4>
            </div>
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Id_Paquete)

                <div class="row g-4">
                    <!-- Columna izquierda -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100 bg-light">
                            <h5 class="border-bottom pb-2 mb-3">Información General</h5>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.NumeroRastreo, "Número de Rastreo", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.NumeroRastreo, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.NumeroRastreo, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Cliente, "Tipo de Cliente", new { @class = "form-label fw-bold" })
                                @Html.EnumDropDownListFor(model => model.Cliente, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.Cliente, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Tipo, "Tipo del Paquete", new { @class = "form-label fw-bold" })
                                @Html.EnumDropDownListFor(model => model.Tipo, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.Tipo, "", new { @class = "text-danger" })
                            </div>

                            <h5 class="border-bottom pb-2 mb-3 mt-4">Información del Emisor</h5>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.NombreEmisor, "Nombre del Emisor", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.NombreEmisor, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.NombreEmisor, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.CedulaEmisor, "Cédula del Emisor", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.CedulaEmisor, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.CedulaEmisor, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <!-- Columna derecha -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100 bg-light">
                            <h5 class="border-bottom pb-2 mb-3">Información del Receptor</h5>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.NombreReceptor, "Nombre del Receptor", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.NombreReceptor, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.NombreReceptor, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.CedulaReceptor, "Cédula del Receptor", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.CedulaReceptor, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.CedulaReceptor, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="form-check form-switch">
                                        @Html.EditorFor(model => model.Domicilio, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.Domicilio, "Entrega a Domicilio", new { @class = "form-check-label ms-2 fw-bold" })
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(model => model.Domicilio, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="form-check form-switch">
                                        @Html.EditorFor(model => model.Pago, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.Pago, "Pago Realizado", new { @class = "form-check-label ms-2 fw-bold" })
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(model => model.Pago, "", new { @class = "text-danger" })
                            </div>

                            <div id="direccion-group" class="form-group mb-3">
                                @Html.LabelFor(model => model.Direccion, "Dirección de Entrega", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.Direccion, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Direccion, "", new { @class = "text-danger" })
                            </div>

                            <div id="telefono-group" class="form-group mb-3">
                                @Html.LabelFor(model => model.TelefonoDomicilio, "Teléfono", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.TelefonoDomicilio, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.TelefonoDomicilio, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Descripcion, "Descripción del Paquete", new { @class = "form-label fw-bold" })
                                @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.fecha_recibo, "Fecha de Recibo", new { @class = "form-label fw-bold" })
                                        @Html.EditorFor(model => model.fecha_recibo, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                        @Html.ValidationMessageFor(model => model.fecha_recibo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        @Html.LabelFor(model => model.fecha_entrega, "Fecha de Entrega", new { @class = "form-label fw-bold" })
                                        @Html.EditorFor(model => model.fecha_entrega, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                        @Html.ValidationMessageFor(model => model.fecha_entrega, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <button type="submit" class="btn btn-positivo me-2">
                            <i class="fas fa-save me-2"></i>Guardar
                        </button>
                        @Html.ActionLink("Regresar a la lista", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    }
</div>

    <script>
        $(document).ready(function () {
            function toggleDireccion() {
                if ($('#pago-checkbox').is(':checked')) {
                    $('#direccion-group').show();
                    $('#telefono-group').show();
                } else {
                    $('#direccion-group').hide();
                    $('#telefono-group').hide();
                }
            }

            toggleDireccion();

            $('#pago-checkbox').change(function () {
                toggleDireccion();
            });

            function toggleCedulaFields() {
                var selectedValue = $("#tipoCliente").val();
                if (selectedValue == 1) {
                    $("#cedulaEmisor-group").hide();
                    $("#cedulaReceptor-group").hide();
                } else {
                    $("#cedulaEmisor-group").show();
                    $("#cedulaReceptor-group").show();
                }
            }

            // Ejecutar la función al cargar la página para establecer el estado inicial
            toggleCedulaFields();

            // Ejecutar la función cada vez que se cambie el valor del dropdown
            $("#tipoCliente").change(function () {
                toggleCedulaFields();
            });
        });
    </script>
