@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Paquete>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5 login-container">
        <div class="row justify-content-center w-100">
            <div class="col-12">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                    <h2 class="text-center mb-4">Paquetes</h2>

                    @if (Session["Usuario"] != null)
                    {
                        var usuarioRol = (Rol)Session["UsuarioRol"];
                        <div class="d-flex justify-content-center mb-4">
                            @if (usuarioRol == Rol.Administrador)
                            {
                                <a href="@Url.Action("RegistrarPaqueteAdmin", "Paquetes")" class="btn btn-action" style="background-color: var(--bg-positivo); color: white;">
                                    <i class="fas fa-box-open me-2"></i><span>Agregar Paquete</span>
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("RegistrarPaquete", "Paquetes")" class="btn btn-action" style="background-color: var(--bg-positivo); color: white;">
                                    <i class="fas fa-box-open me-2"></i><span>Agregar Paquete</span>
                                </a>
                            }
                        </div>
                    }

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h4 class="mb-0">Buscar Paquetes</h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6 col-lg-4">
                                    <label class="form-label">Número de Rastreo</label>
                                    <input type="text" class="form-control" id="searchString">
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <label class="form-label">Nombre del Cliente</label>
                                    <input type="text" class="form-control" id="searchName">
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <label class="form-label">Cédula</label>
                                    <input type="text" class="form-control" id="searchCedula">
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <label class="form-label">Fecha Inicio</label>
                                    <input type="date" class="form-control" id="startDate">
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <label class="form-label">Fecha Fin</label>
                                    <input type="date" class="form-control" id="endDate">
                                </div>
                                <div class="col-12">
                                    <button type="button" onclick="limpiarBusqueda()" class="btn btn-action" style="background-color: var(--bg-dark); color: white;">
                                        <i class="fas fa-eraser me-2"></i>Limpiar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover" id="paquetesTable">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.NumeroRastreo)</th>
                                    <th>@Html.DisplayNameFor(model => model.Tipo)</th>
                                    <th>@Html.DisplayNameFor(model => model.Estado)</th>
                                    <th>@Html.DisplayNameFor(model => model.NombreEmisor)</th>
                                    <th>@Html.DisplayNameFor(model => model.CedulaEmisor)</th>
                                    <th>@Html.DisplayNameFor(model => model.Domicilio)</th>
                                    <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                                    <th>@Html.DisplayNameFor(model => model.TelefonoDomicilio)</th>
                                    <th>@Html.DisplayNameFor(model => model.Pago)</th>
                                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Contenido dinámico -->
                            </tbody>
                        </table>
                    </div>

                    <nav class="mt-4">
                        <ul class="pagination justify-content-center" id="pagination"></ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #paquetesTable {
        max-height: 600px;
        overflow-y: auto;
    }

        #paquetesTable thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background: var(--bs-light);
        }

    .btn-icon {
        padding: 0.25rem 0.5rem;
        margin: 0 0.125rem;
        transition: all 0.3s ease;
    }

        .btn-icon:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

    .btn-action {
        transition: all 0.3s ease;
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            opacity: 0.9;
        }

    .table td {
        vertical-align: middle;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    let currentPage = 1;
    let totalPages = 1;
    let isLoading = false;

    function renderPagination(totalPages) {
        // [Código de paginación existente]
    }

    function loadPaquetes(page, reset = false) {
        if (isLoading) return;
        isLoading = true;

        const searchString = $('#searchString').val();
        const searchName = $('#searchName').val();
        const searchCedula = $('#searchCedula').val();
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();

        $.ajax({
            url: '@Url.Action("GetPaquetes", "Paquetes")',
            type: 'GET',
            data: {
                page: page,
                searchString: searchString,
                searchName: searchName,
                searchCedula: searchCedula,
                startDate: startDate,
                endDate: endDate
            },
            success: function (response) {
                totalPages = response.totalPages;
                let tableBody = reset ? '' : $('#paquetesTable tbody').html();

                response.data.forEach(paquete => {
                    tableBody += `
                        <tr>
                            <td>${paquete.NumeroRastreo}</td>
                            <td>${paquete.Tipo}</td>
                            <td>${paquete.Estado}</td>
                            <td>${paquete.NombreEmisor}</td>
                            <td>${paquete.CedulaEmisor}</td>
                            <td>${paquete.Domicilio}</td>
                            <td>${paquete.Direccion}</td>
                            <td>${paquete.TelefonoDomicilio}</td>
                            <td>${paquete.Pago}</td>
                            <td>${paquete.Descripcion}</td>
                            <td>
                                <a href="/Paquetes/Edit/${paquete.Id_Paquete}" class="btn btn-icon" style="background-color: var(--bg-positivo); color: white;" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Paquetes/Details/${paquete.Id_Paquete}" class="btn btn-icon" style="background-color: var(--bg-info); color: white;" title="Detalles">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a href="/Paquetes/Delete/${paquete.Id_Paquete}" class="btn btn-icon" style="background-color: var(--bg-negativo); color: white;" title="Borrar">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>`;
                });

                if (reset) {
                    $('#paquetesTable tbody').html(tableBody);
                } else {
                    $('#paquetesTable tbody').append(tableBody);
                }

                renderPagination(totalPages);
                isLoading = false;
            },
            error: function() {
                isLoading = false;
            }
        });
    }

    $('input').on('input', function() {
        currentPage = 1;
        loadPaquetes(currentPage, true);
    });

    $('input[type="date"]').on('change', function() {
        currentPage = 1;
        loadPaquetes(currentPage, true);
    });

    window.limpiarBusqueda = function () {
        $('#searchString, #searchName, #searchCedula, #startDate, #endDate').val('');
        currentPage = 1;
        loadPaquetes(currentPage, true);
    }

    loadPaquetes(currentPage);
});
</script>