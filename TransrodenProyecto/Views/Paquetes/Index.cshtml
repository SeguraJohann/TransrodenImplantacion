@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Paquete>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center">Paquetes</h2>

    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("RegistrarPaquete", "Paquetes")" class="btn btn-danger">
            <i class="fas fa-box"></i> Agregar Paquete
        </a>
    </div>

    <!--Barra de busqueda-->
    <div class="form-horizontal">
        <h4>Buscar Paquetes</h4>
        <hr />
        <div class="form-group">
            @Html.Label("Número de Rastreo", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBox("searchString", "", new { @class = "form-control", id = "searchString" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Nombre del Cliente", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBox("searchName", "", new { @class = "form-control", id = "searchName" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Cédula", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBox("searchCedula", "", new { @class = "form-control", id = "searchCedula" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Fecha Inicio", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBox("startDate", "", new { @class = "form-control", @type = "date", id = "startDate" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Fecha Fin", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBox("endDate", "", new { @class = "form-control", @type = "date", id = "endDate" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="button" onclick="limpiarBusqueda()" class="btn btn-primary">Limpiar</button>
            </div>
        </div>
    </div>

    <h2>Lista de Paquetes</h2>
    <table class="table" id="paquetesTable">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.NumeroRastreo)</th>
                <th>@Html.DisplayNameFor(model => model.Tipo)</th>
                <th>@Html.DisplayNameFor(model => model.Estado)</th>
                <th>@Html.DisplayNameFor(model => model.NombreEmisor)</th>
                <th>@Html.DisplayNameFor(model => model.CedulaEmisor)</th>
                <th>@Html.DisplayNameFor(model => model.Domicilio)</th>
                <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                <th>@Html.DisplayNameFor(model => model.TelefonoDomicilio)</th>
                <th>@Html.DisplayNameFor(model => model.Pago)</th>
                <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <!--Contenido dinámico-->
        </tbody>
    </table>

    <nav>
        <ul class="pagination" id="pagination"></ul>
    </nav>
</div>

<style>
    #paquetesTable {
        display: block;
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #ddd;
    }

        #paquetesTable thead {
            position: sticky;
            top: 0;
            background: #f8f9fa;
        }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
        $(document).ready(function () {
            let currentPage = 1;
            let totalPages = 1;
            let isLoading = false;

            function renderPagination(totalPages) {
                const maxVisiblePages = 5; // Número de páginas visibles
                let paginationHtml = '';

                // Botón Anterior
                paginationHtml += `
                        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                            <a class="page-link" href="#" data-page="${currentPage - 1}">&laquo;</a>
                        </li>`;

                // Lógica para determinar qué números de página mostrar
                let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
                let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

                // Ajustar startPage si estamos cerca del final
                if (endPage - startPage + 1 < maxVisiblePages) {
                    startPage = Math.max(1, endPage - maxVisiblePages + 1);
                }

                // Primera página y ellipsis si es necesario
                if (startPage > 1) {
                    paginationHtml += `
                            <li class="page-item">
                                <a class="page-link" href="#" data-page="1">1</a>
                            </li>`;
                    if (startPage > 2) {
                        paginationHtml += `
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>`;
                    }
                }

                // Páginas intermedias
                for (let i = startPage; i <= endPage; i++) {
                    paginationHtml += `
                            <li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="#" data-page="${i}">${i}</a>
                            </li>`;
                }

                // Última página y ellipsis si es necesario
                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        paginationHtml += `
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>`;
                    }
                    paginationHtml += `
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>
                        </li>`;
                }

                // Botón Siguiente
                paginationHtml += `
                    <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="${currentPage + 1}">&raquo;</a>
                    </li>`;

                $('#pagination').html(paginationHtml);

                // Evento de clic para los números de página
                $('#pagination .page-link').click(function(e) {
                    e.preventDefault();
                    const page = $(this).data('page');

                    // Verificar que el número de página sea válido
                    if (page && page >= 1 && page <= totalPages && page !== currentPage) {
                        currentPage = page;
                        loadPaquetes(currentPage, true);
                    }
                });
            }

            function loadPaquetes(page, reset = false) {
                if (isLoading) return;
                isLoading = true;

                const searchString = $('#searchString').val();
                const searchName = $('#searchName').val();
                const searchCedula = $('#searchCedula').val();
                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();

                $.ajax({
                    url: '@Url.Action("GetPaquetes", "Paquetes")',
                    type: 'GET',
                    data: {
                        page: page,
                        searchString: searchString,
                        searchName: searchName,
                        searchCedula: searchCedula,
                        startDate: startDate,
                        endDate: endDate
                    },
                    success: function (response) {
                        totalPages = response.totalPages;

                        let tableBody = reset ? '' : $('#paquetesTable tbody').html();
                        response.data.forEach(paquete => {
                            tableBody += `
                                <tr>
                                    <td>${paquete.NumeroRastreo}</td>
                                    <td>${paquete.Tipo}</td>
                                    <td>${paquete.Estado}</td>
                                    <td>${paquete.NombreEmisor}</td>
                                    <td>${paquete.CedulaEmisor}</td>
                                    <td>${paquete.Domicilio}</td>
                                    <td>${paquete.Direccion}</td>
                                    <td>${paquete.TelefonoDomicilio}</td>
                                    <td>${paquete.Pago}</td>
                                    <td>${paquete.Descripcion}</td>
                                    <td>
                                        <a href="/Paquetes/Edit/${paquete.Id_Paquete}" class="btn btn-success btn-sm">Editar</a>
                                        <a href="/Paquetes/Details/${paquete.Id_Paquete}" class="btn btn-primary btn-sm">Detalles</a>
                                        <a href="/Paquetes/Delete/${paquete.Id_Paquete}" class="btn btn-danger btn-sm">Borrar</a>
                                    </td>
                                </tr>`;
                        });

                        if (reset) {
                            $('#paquetesTable tbody').html(tableBody);
                        } else {
                            $('#paquetesTable tbody').append(tableBody);
                        }

                        renderPagination(totalPages);
                        isLoading = false;
                    },
                    error: function() {
                        isLoading = false;
                    }
                });
            }

            // Real-time search and filter
            $('input').on('input', function() {
                currentPage = 1;
                loadPaquetes(currentPage, true);
            });

            // Date change
            $('input[type="date"]').on('change', function() {
                currentPage = 1;
                loadPaquetes(currentPage, true);
            });

            window.limpiarBusqueda = function () {
                $('#searchString, #searchName, #searchCedula, #startDate, #endDate').val('');
                currentPage = 1;
                loadPaquetes(currentPage, true);
            }

            // Initial load
            loadPaquetes(currentPage);
        });
</script>

