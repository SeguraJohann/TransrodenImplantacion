@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Usuario>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5 login-container">
        <div class="row justify-content-center w-100">
            <div class="col-12">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                    <h2 class="text-center mb-4">Lista de Usuarios</h2>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="d-flex justify-content-center mb-4">
                        <a href="@Url.Action("Create", "Usuarios")" class="btn btn-action button-add">
                            <i class="fas fa-user-plus me-2"></i><span>Agregar Usuario</span>
                        </a>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h4 class="mb-0">Buscar Usuarios</h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Búsqueda por Cédula o Nombre</label>
                                    <input type="text" id="searchCed" class="form-control" placeholder="Ingresa número de cédula o nombre">
                                </div>
                                <div class="col-12">
                                    <button type="button" onclick="limpiarBusqueda()" class="btn btn-action button-clean">
                                        <i class="fas fa-eraser me-2"></i>Limpiar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <div class="table-responsive shadow-sm rounded">
                            <table class="table table-hover align-middle mb-0 bg-white" id="usuariosTable">
                                <thead>
                                    <tr class="bg-light">
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">Nombre</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">Apellidos</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">Cédula</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">Correo</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">Teléfono</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">Rol</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- El contenido dinámico se genera vía JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <nav class="mt-4">
                        <ul class="pagination justify-content-center" id="pagination"></ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    let currentPage = 1;
    let totalPages = 1;
    let isLoading = false;

    // Función para convertir el número de rol en su representación textual
    function getRolName(rolNumber) {
        const roles = {
            0: "Administrador",
            1: "Bodeguero",
            2: "Transportista",
            3: "Cliente"
        };
        return roles[rolNumber] || rolNumber.toString();
    }

    function loadUsuarios(page, searchQuery = '') {
        if (isLoading) return;
        isLoading = true;

        $.ajax({
            url: '@Url.Action("GetUsuarios", "Usuarios")',
            type: 'GET',
            data: { page: page, searchCed: searchQuery },
            success: function (response) {
                const usuarios = response.data;
                totalPages = response.totalPages;

                let tableBody = '';
                usuarios.forEach(usuario => {
                    // Verificar si es administrador para modificar botones
                    const deleteButton = usuario.Rol == 0
                        ? `<button class="btn btn-icon button-delete disabled" title="No se puede eliminar administradores"><i class="fas fa-trash"></i></button>`
                        : `<a href="/Usuarios/Delete/${usuario.Id_Usuario}" class="btn btn-icon button-delete" title="Borrar"><i class="fas fa-trash"></i></a>`;

                    tableBody += `
                        <tr>
                            <td>${usuario.Nombre}</td>
                            <td>${usuario.Apellidos}</td>
                            <td>${usuario.Cedula}</td>
                            <td>${usuario.Correo}</td>
                            <td>${usuario.Telefono}</td>
                            <td>${getRolName(usuario.Rol)}</td>
                            <td>
                                <a href="/Usuarios/Edit/${usuario.Id_Usuario}" class="btn btn-icon button-edit" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Usuarios/Details/${usuario.Id_Usuario}" class="btn btn-icon button-details" title="Detalles">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                ${deleteButton}
                            </td>
                        </tr>`;
                });

                $('#usuariosTable tbody').html(tableBody);
                renderPagination(totalPages);
                isLoading = false;
            },
            error: function() {
                isLoading = false;
            }
        });
    }

    function renderPagination(totalPages) {
        const maxVisiblePages = 5;
        let paginationHtml = '';

        paginationHtml += `
            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage - 1}">&laquo;</a>
            </li>`;

        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

        if (endPage - startPage + 1 < maxVisiblePages) {
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
        }

        if (startPage > 1) {
            paginationHtml += `
                <li class="page-item">
                    <a class="page-link" href="#" data-page="1">1</a>
                </li>`;
            if (startPage > 2) {
                paginationHtml += `
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>`;
            }
        }

        for (let i = startPage; i <= endPage; i++) {
            paginationHtml += `
                <li class="page-item ${i === currentPage ? 'active' : ''}">
                    <a class="page-link" href="#" data-page="${i}">${i}</a>
                </li>`;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                paginationHtml += `
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>`;
            }
            paginationHtml += `
                <li class="page-item">
                    <a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>
                </li>`;
        }

        paginationHtml += `
            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage + 1}">&raquo;</a>
            </li>`;

        $('#pagination').html(paginationHtml);

        $('#pagination .page-link').click(function(e) {
            e.preventDefault();
            const page = $(this).data('page');
            if (page && page >= 1 && page <= totalPages && page !== currentPage) {
                currentPage = page;
                loadUsuarios(currentPage, $('#searchCed').val());
            }
        });
    }

    let searchTimeout;
    $('#searchCed').on('input', function () {
        const searchQuery = $(this).val();
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            currentPage = 1;
            loadUsuarios(currentPage, searchQuery);
        }, 300);
    });

    window.limpiarBusqueda = function () {
        $('#searchCed').val('');
        currentPage = 1;
        loadUsuarios(currentPage, '');
    }

    loadUsuarios(currentPage);
});
</script>