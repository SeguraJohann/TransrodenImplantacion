@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Usuario>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Contenido Principal -->
<div class="container mt-5">
    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("Create", "Usuarios")" class="btn btn-danger">
            <i class="fas fa-user-plus"></i> Agregar Usuario
        </a>
    </div>

    <div class="form-group">
        <label for="searchCed">Buscar Usuario:</label>
        <input type="text" id="searchCed" class="form-control" placeholder="Ingresa número de cédula o nombre" />
    </div>

    <h2 class="mb-4">Lista de Usuarios</h2>

    <div style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered" id="usuariosTable">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>Cédula</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination" id="pagination"></ul>
    </nav>
</div>


<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
        $(document).ready(function () {
            let currentPage = 1;
            let totalPages = 1;
            let isLoading = false;

            function loadUsuarios(page, searchQuery = '') {
                if (isLoading) return;
                isLoading = true;

                $.ajax({
                    url: '@Url.Action("GetUsuarios", "Usuarios")',
                    type: 'GET',
                    data: { page: page, searchCed: searchQuery },
                    success: function (response) {
                        const usuarios = response.data;
                        totalPages = response.totalPages;

                        let tableBody = '';
                        usuarios.forEach(usuario => {
                            tableBody += `
                                <tr>
                                    <td>${usuario.Nombre}</td>
                                    <td>${usuario.Apellidos}</td>
                                    <td>${usuario.Cedula}</td>
                                    <td>${usuario.Correo}</td>
                                    <td>${usuario.Telefono}</td>
                                    <td>${usuario.Rol}</td>
                                    <td>
                                        <a href="/Usuarios/Edit/${usuario.Id_Usuario}" class="btn btn-success">Editar</a>
                                        <a href="/Usuarios/Details/${usuario.Id_Usuario}" class="btn btn-primary">Detalles</a>
                                        <a href="/Usuarios/Delete/${usuario.Id_Usuario}" class="btn btn-danger">Borrar</a>
                                    </td>
                                </tr>`;
                        });

                        $('#usuariosTable tbody').html(tableBody);
                        renderPagination(totalPages, searchQuery);
                        isLoading = false;
                    },
                    error: function() {
                        isLoading = false;
                    }
                });
            }

            function renderPagination(totalPages, searchQuery = '') {
                const maxVisiblePages = 5;
                let paginationHtml = '';

                // Botón Anterior
                paginationHtml += `
                    <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="${currentPage - 1}">&laquo;</a>
                    </li>`;

                // Lógica para determinar qué números de página mostrar
                let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
                let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

                // Ajustar startPage si estamos cerca del final
                if (endPage - startPage + 1 < maxVisiblePages) {
                    startPage = Math.max(1, endPage - maxVisiblePages + 1);
                }

                // Primera página y ellipsis si es necesario
                if (startPage > 1) {
                    paginationHtml += `
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="1">1</a>
                        </li>`;
                    if (startPage > 2) {
                        paginationHtml += `
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>`;
                    }
                }

                // Páginas intermedias
                for (let i = startPage; i <= endPage; i++) {
                    paginationHtml += `
                        <li class="page-item ${i === currentPage ? 'active' : ''}">
                            <a class="page-link" href="#" data-page="${i}">${i}</a>
                        </li>`;
                }

                // Última página y ellipsis si es necesario
                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        paginationHtml += `
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>`;
                    }
                    paginationHtml += `
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>
                        </li>`;
                }

                // Botón Siguiente
                paginationHtml += `
                    <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="#" data-page="${currentPage + 1}">&raquo;</a>
                    </li>`;

                $('#pagination').html(paginationHtml);

                // Evento de clic para los números de página
                $('#pagination .page-link').click(function(e) {
                    e.preventDefault();
                    const page = $(this).data('page');

                    if (page && page >= 1 && page <= totalPages && page !== currentPage) {
                        currentPage = page;
                        loadUsuarios(currentPage, searchQuery);
                    }
                });
            }

            // Búsqueda con debounce
            let searchTimeout;
            $('#searchCed').on('input', function () {
                const searchQuery = $(this).val();
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentPage = 1;
                    loadUsuarios(currentPage, searchQuery);
                }, 300);
            });

            // Cargar usuarios iniciales
            loadUsuarios(currentPage);
        });
</script>

