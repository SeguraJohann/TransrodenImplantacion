@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Usuario
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5 login-container">
        <div class="row justify-content-center w-100">
            <div class="col-12">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                    <div class="mb-4 text-center">
                        <h2 class="mb-0">Enviar Notificación</h2>
                    </div>

                    <form id="notificationForm" method="post" action="@Url.Action("EnviarBoletin", "Marketing")" enctype="multipart/form-data">
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h4 class="mb-0">Detalles de la Notificación</h4>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="tipoNotificacion" class="form-label fw-bold">Tipo de Notificación</label>
                                            <select id="tipoNotificacion" class="form-select" onchange="updateFormAction()">
                                                <option value="EnviarBoletin">Boletín</option>
                                                <option value="EnviarImportante">AVISO IMPORTANTE!</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="asunto" class="form-label fw-bold">Asunto</label>
                                            <textarea class="form-control" id="asunto" name="Asunto" rows="2"
                                                      placeholder="Escriba el asunto de la notificación" required></textarea>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="mensaje" class="form-label fw-bold">Mensaje</label>
                                            <textarea class="form-control" id="mensaje" name="Mensaje" rows="6"
                                                      placeholder="Escriba el mensaje de la notificación" required></textarea>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="imagen" class="form-label fw-bold">Subir Imagen</label>
                                            <input type="file" class="form-control" id="imagen" name="Imagen"
                                                   accept="image/*" onchange="previewImage(event)">
                                            <div class="mt-3 text-center">
                                                <img id="preview" src="#" alt="Vista previa de la imagen"
                                                     style="display: none; max-width: 300px; max-height: 300px;"
                                                     class="img-fluid rounded shadow-sm" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" id="submitBtn" class="btn btn-lg btn-positivo" disabled>
                                <i class="fas fa-paper-plane me-2"></i>Enviar Notificación
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        var preview = document.getElementById('preview');
        var reader = new FileReader();
        reader.onload = function () {
            preview.src = reader.result;
            preview.style.display = 'block';
        };
        reader.readAsDataURL(event.target.files[0]);
    }

    function checkFields() {
        const asunto = document.getElementById('asunto').value.trim();
        const mensaje = document.getElementById('mensaje').value.trim();
        const submitBtn = document.getElementById('submitBtn');

        if (asunto && mensaje) {
            submitBtn.removeAttribute('disabled');
            submitBtn.classList.add('btn-positivo');
            submitBtn.classList.remove('btn-secondary');
        } else {
            submitBtn.setAttribute('disabled', '');
            submitBtn.classList.remove('btn-positivo');
            submitBtn.classList.add('btn-secondary');
        }
    }

    function updateFormAction() {
        const tipoNotificacion = document.getElementById('tipoNotificacion').value;
        const form = document.getElementById('notificationForm');
        form.action = tipoNotificacion === 'EnviarImportante' ? '@Url.Action("EnviarImportante", "Marketing")' : '@Url.Action("EnviarBoletin", "Marketing")';
    }

    document.getElementById('asunto').addEventListener('input', checkFields);
    document.getElementById('mensaje').addEventListener('input', checkFields);
    checkFields();
</script>