@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <!-- Main Container -->
    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5">
        <!-- Padding exterior de la caja login -->
        <div class="row justify-content-center w-100">
            <!-- Ancho de la caja login -->
            <div class="col-lg-4 col-md-6">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                    <h2 class="text-center mb-4">Envío de boletín</h2>


                    @using (Html.BeginForm("RecuperarClave", "CorreoEnviado", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()



                        <div class="form-group">

                            <h1>Se ha enviado el correo a todos los clientes.</h1>
                            <br>
                            <a href="@Url.Action("IndexAdmin", "Admin")" class="btn btn-primary">Volver a Inicio</a>

                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
