@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Facturacion>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <!-- Body content-->

    <div class="container mt-5">

        <h2>Mis Facturas</h2>

        @if (ViewBag.Message != null)
        {
            <p class="alert alert-info">@ViewBag.Message</p>
        }

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Paquete</th>
                    @*<th>Cantidad</th>*@
                    <th>Precio</th>
                    <th>IVA</th>
                    <th>Total</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in Model)
                {
                    <tr>
                        <td>@factura.Paquete.Descripcion</td>
                        @*<td>@factura.Cantidad</td>*@
                        <td>@factura.Precio</td>
                        <td>@factura.Iva</td>
                        <td>@factura.Total</td>
                        <td>@factura.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            @Html.ActionLink("Detalles", "DetalleFacturacionUsuario", new { id = factura.Id_Facturacion }, new { @class = "btn btn-primary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
    <!--Body content end-->