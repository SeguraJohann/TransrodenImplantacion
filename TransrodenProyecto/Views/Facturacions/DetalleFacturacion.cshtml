@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Facturacion

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h4 class="text-center mb-0">Detalles de la Facturación</h4>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <!-- Columna izquierda -->
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light">
                        <h5 class="border-bottom pb-2 mb-3">Información de la Factura</h5>
                        <div class="mb-3">
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Factura N°:</div>
                                <div class="col-7">@Model.Id_Facturacion</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Fecha de Emisión:</div>
                                <div class="col-7">@Model.Fecha.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Precio:</div>
                                <div class="col-7">@String.Format("{0:C}", Model.Precio)</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Subtotal:</div>
                                <div class="col-7">@String.Format("{0:C}", Model.Iva)</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Total:</div>
                                <div class="col-7">@String.Format("{0:C}", Model.Total)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Columna derecha -->
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light">
                        <h5 class="border-bottom pb-2 mb-3">Detalles del Paquete</h5>
                        <div class="mb-3">
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Paquete N°:</div>
                                <div class="col-7">@Model.Paquete.Id_Paquete</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Rastreo N°:</div>
                                <div class="col-7">@Model.Paquete.NumeroRastreo</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Emisor:</div>
                                <div class="col-7">@Model.Paquete.NombreEmisor</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Cédula del Emisor:</div>
                                <div class="col-7">@Model.Paquete.CedulaEmisor</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Receptor:</div>
                                <div class="col-7">@Model.Paquete.NombreReceptor</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Destino:</div>
                                <div class="col-7">@Model.Paquete.Direccion</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del Usuario -->
            <div class="row mt-4">
                <div class="col-12">
                    @if (Model.Usuario != null)
                    {
                        <div class="border rounded p-3 bg-light">
                            <h5 class="border-bottom pb-2 mb-3">Detalles del Usuario Asociado</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Usuario N°:</div>
                                        <div class="col-7">@Model.Usuario.Id_Usuario</div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Nombre:</div>
                                        <div class="col-7">@Model.Usuario.Nombre</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Cédula:</div>
                                        <div class="col-7">@Model.Usuario.Cedula</div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Email:</div>
                                        <div class="col-7">@Model.Usuario.Correo</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Nota:</strong> No hay un usuario asociado con la cédula del emisor.
                        </div>
                    }
                </div>
            </div>

            <!-- Botones -->
            <div class="row mt-4">
                <div class="col-12 text-center">
                    <div class="btn-group">
                        @Html.ActionLink("Ir a Paquetes", "Index", "Paquetes", null, new { @class = "btn btn-primary me-2" })
                        @Html.ActionLink("Ir a Facturas", "Index", "Facturacions", null, new { @class = "btn btn-primary me-2" })
                        <button type="button" onclick="abrirVentanaImpresion(@Model.Id_Facturacion)" class="btn btn-primary me-2">
                            <i class="fas fa-print me-2"></i>Imprimir
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/js/main.js"></script>
<script type="text/javascript">
    function abrirVentanaImpresion(idFactura) {
        var url = '@Url.Action("ImprimirFactura", "Facturacions", new { id = "__id__" })';
        url = url.replace("__id__", idFactura);
        var opciones = "width=300,height=600,scrollbars=yes,resizable=yes";
        window.open(url, "Imprimir Factura", opciones);
    }
</script>