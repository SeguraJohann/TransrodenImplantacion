@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Facturacion>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">


    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("Create", "Facturacions")" class="btn btn-danger">
            <i class="fas fa-box-plus"></i> Agregar Factura
        </a>
    </div>


    <!-- Barra de búsqueda -->
    <form method="get" action="@Url.Action("Index", "Facturacions")">
        <div class="form-group">
            <label for="searchId">Buscar Factura:</label>
            <input type="number" name="searchId" id="searchId" class="form-control" placeholder="Ingrese ID de la Factura" />
            <br>
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>
    <br>
    <br>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Paquete.NumeroRastreo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NombreEmisor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CedulaEmisor)
            </th>
            @*<th>
                    @Html.DisplayNameFor(model => model.Cantidad)
                </th>*@
            <th>
                @Html.DisplayNameFor(model => model.Precio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Iva)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Total)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Paquete.NumeroRastreo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Usuario.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreEmisor)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CedulaEmisor)
                </td>
                @*<td>
                        @Html.DisplayFor(modelItem => item.Cantidad)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.Precio)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Iva)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Total)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Fecha)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id_Facturacion }, new { @class = "btn btn-success" }) |
                    @Html.ActionLink("Detalle", "DetalleFacturacion", new { id = item.Id_Facturacion }, new { @class = "btn btn-primary" }) |
                    @Html.ActionLink("Borrar", "Delete", new { id = item.Id_Facturacion }, new { @class = "btn btn-danger" })
                </td>
            </tr>
        }

    </table>
</div>
