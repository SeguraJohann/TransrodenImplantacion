@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Facturacion>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5 login-container">
        <div class="row justify-content-center w-100">
            <div class="col-12">
                <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                    <h2 class="text-center mb-4">Lista de Facturaciones</h2>

                    <div class="d-flex justify-content-center mb-4">
                        <a href="@Url.Action("Create", "Facturacions")" class="btn btn-action button-add">
                            <i class="fas fa-box-plus me-2"></i><span>Agregar Factura</span>
                        </a>
                    </div>
                    

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h4 class="mb-0">Buscar Factura</h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Búsqueda por ID de Factura</label>
                                    <input type="number" id="searchId" class="form-control" placeholder="Ingrese ID de la Factura" min="1">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <div class="table-responsive shadow-sm rounded">
                            <table class="table table-hover align-middle mb-0 bg-white" id="facturacionTable">
                                <thead>
                                    <tr class="bg-light">
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.Id_Facturacion)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.Paquete.NumeroRastreo)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.Usuario.Nombre)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.NombreEmisor)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.CedulaEmisor)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.Precio)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.Iva)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold">@Html.DisplayNameFor(model => model.Total)</th>
                                        <th class="px-4 py-3 text-uppercase small font-weight-bold text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Contenido dinámico -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <nav class="mt-4">
                        <ul class="pagination justify-content-center" id="pagination"></ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    let currentPage = 1;
    let totalPages = 1;
    let isLoading = false;

    function renderPagination(totalPages, searchId = '') {
        const maxVisiblePages = 5; // Número de páginas visibles
        let paginationHtml = '';

        // Botón Anterior
        paginationHtml += `
            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage - 1}">&laquo;</a>
            </li>`;

        // Lógica para determinar qué números de página mostrar
        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

        // Ajustar startPage si estamos cerca del final
        if (endPage - startPage + 1 < maxVisiblePages) {
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
        }

        // Primera página y ellipsis si es necesario
        if (startPage > 1) {
            paginationHtml += `
                <li class="page-item">
                    <a class="page-link" href="#" data-page="1">1</a>
                </li>`;
            if (startPage > 2) {
                paginationHtml += `
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>`;
            }
        }

        // Páginas intermedias
        for (let i = startPage; i <= endPage; i++) {
            paginationHtml += `
                <li class="page-item ${i === currentPage ? 'active' : ''}">
                    <a class="page-link" href="#" data-page="${i}">${i}</a>
                </li>`;
        }

        // Última página y ellipsis si es necesario
        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                paginationHtml += `
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>`;
            }
            paginationHtml += `
                <li class="page-item">
                    <a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>
                </li>`;
        }

        // Botón Siguiente
        paginationHtml += `
            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage + 1}">&raquo;</a>
            </li>`;

        $('#pagination').html(paginationHtml);

        // Evento de clic para los números de página
        $('#pagination .page-link').click(function(e) {
            e.preventDefault();
            const page = $(this).data('page');

            // Verificar que el número de página sea válido
            if (page && page >= 1 && page <= totalPages && page !== currentPage) {
                currentPage = page;
                loadFacturaciones(currentPage, searchId);
            }
        });
    }

    function loadFacturaciones(page, searchId = '') {
        if (isLoading) return;
        isLoading = true;

        $.ajax({
            url: '@Url.Action("GetFacturaciones", "Facturacions")',
            type: 'GET',
            data: { page: page, searchId: searchId },
            success: function (response) {
                const facturaciones = response.data;
                totalPages = response.totalPages;

                let tableBody = '';
                facturaciones.forEach(factura => {
                    tableBody += `
                        <tr>
                            <td>${factura.Id_Facturacion}</td>
                            <td>${factura.Paquete?.NumeroRastreo || '-'}</td>
                            <td>${factura.Usuario?.Nombre || '-'}</td>
                            <td>${factura.NombreEmisor}</td>
                            <td>${factura.CedulaEmisor}</td>
                            <td>${factura.Precio}</td>
                            <td>${factura.Iva}</td>
                            <td>${factura.Total}</td>
                            <td>
                                <a href="/Facturacions/Edit/${factura.Id_Facturacion}" class="btn btn-success">Editar</a>
                                <a href="/Facturacions/DetalleFacturacion/${factura.Id_Facturacion}" class="btn btn-primary">Detalles</a>
                                <a href="/Facturacions/Delete/${factura.Id_Facturacion}" class="btn btn-danger">Borrar</a>
                            </td>
                        </tr>`;
                });

                $('#facturacionTable tbody').html(tableBody);
                renderPagination(totalPages, searchId);
                isLoading = false;
            },
            error: function() {
                isLoading = false;
            }
        });
    }

    // Actualizar la búsqueda en tiempo real con debounce
    let searchTimeout;
    $('#searchId').on('keyup', function () {
        const searchId = $(this).val();
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            currentPage = 1; // Reiniciar a la primera página
            loadFacturaciones(currentPage, searchId);
        }, 300); // Esperar 300ms después de que el usuario deje de escribir
    });

    // Cargar facturaciones iniciales
    loadFacturaciones(currentPage);
});
</script>
<script>
    document.getElementById('searchId').addEventListener('input', function (event) {
        const value = parseInt(event.target.value); // Obtiene el valor del campo
        if (value < 1 || isNaN(value)) { // Si el valor es menor a 1 o no es un número
            event.target.value = 1; // Establece el valor mínimo permitido (1)
        }
    });
</script>