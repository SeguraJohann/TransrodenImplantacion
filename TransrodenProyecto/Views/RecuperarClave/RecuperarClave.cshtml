@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Main Container -->
<div class="container d-flex align-items-center justify-content-center min-vh-50 py-5">
    <!-- Padding exterior de la caja login -->
    <div class="row justify-content-center w-100">
        <!-- Ancho de la caja login -->
        <div class="col-lg-4 col-md-6">
            <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                <h3 class="text-center mb-4">Recuperar contraseña</h3>


                @using (Html.BeginForm("RecuperarClave", "RecuperarClave", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()



                    <div class="form-group">

                        <label for="correo">Correo:</label>
                        <input type="email" name="correo" class="form-control" required />
                        <br>
                        <button type="submit" class="btn btn-primary">Recuperar contraseña</button>

                    </div>
                }
            </div>
        </div>
    </div>
</div>