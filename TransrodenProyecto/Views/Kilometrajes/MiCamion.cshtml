@model TransrodenProyecto.ViewModels.CamionKmViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">


    <h2 class="text-center">Mi Camión</h2>


    @using (Html.BeginForm("CambiarCamion", "Kilometrajes", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label for="Id_Camion">Cambiar de camión:</label>
            @Html.DropDownList("Id_Camion", Model.CamionesDisponibles, "Seleccione un camión", new { @class = "form-control" })
        </div>
        <br>
        <button type="submit" class="btn btn-danger">Cambiar</button>
    }


    <br>
    <br>

    <div>
        <h4>Camión Actual</h4>
        @if (Model.CamionActual != null)
        {
            <p><strong>@Model.CamionActual.Marca - @Model.CamionActual.Modelo</strong></p>
            <a href="@Url.Action("KmRegistro", "Kilometrajes", new { id = Model.CamionActual.Id_Camion })" class="btn btn-primary">
                Agregar Kilometraje
            </a>
        }
        else
        {
            <p><em>No tiene un camión asignado</em></p>
        }
    </div>

    <br>
    <br>

    <h4>Historial de Kilómetros</h4>

    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Kilometros.First().Km_anterior)</th>
                <th>@Html.DisplayNameFor(model => model.Kilometros.First().Km_actual)</th>
                <th>@Html.DisplayNameFor(model => model.Kilometros.First().Transportista)</th>
                <th>@Html.DisplayNameFor(model => model.Kilometros.First().Registro)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var km in Model.Kilometros)
            {
                <tr>
                    <td>@km.Km_anterior</td>
                    <td>@km.Km_actual</td>
                    <td>@km.Transportista</td>
                    <td>@km.Registro</td>
                </tr>
            }
        </tbody>
    </table>
</div>

