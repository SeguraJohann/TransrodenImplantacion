@model IEnumerable<TransrodenProyecto.Models.Kilometraje>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Camion.Marca)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Km_registrado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Km_actual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transportista)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro)
            </th>
            <th></th>
        </tr>
    
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Camion.Marca)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Km_registrado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Km_actual)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Transportista)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Registro)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.Id_Km }) |
                @Html.ActionLink("Details", "Details", new { id=item.Id_Km }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.Id_Km })
            </td>
        </tr>
    }
    
    </table>
</body>
</html>
