@{
    Layout = null;
    ViewBag.Title = "Contabilidad Diaria";
}

@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Facturacion>

<h2>Contabilidad Diaria</h2>

<!-- Formulario para seleccionar la fecha -->
<form asp-action="ContabilidadDiaria" method="get">
    <div class="form-group">
        <label for="fechaDia">Seleccionar Fecha:</label>
        <input type="date" id="fechaDia" name="fechaDia"
               value="@ViewBag.FechaDia.ToString("yyyy-MM-dd")"
               class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Consultar</button>
</form>

@if (Model != null && Model.Any())
{
    <h3>Resultados para la fecha: @ViewBag.FechaDia.ToShortDateString()</h3>
    <p>Total Diario: @ViewBag.TotalDiario.ToString("C")</p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Id Facturación</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Total</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var factura in Model)
            {
                <tr>
                    <td>@factura.Id_Facturacion</td>
                    <td>@factura.Cantidad</td>
                    <td>@factura.Precio</td>
                    <td>@factura.Total.ToString()</td>
                    <td>@factura.Fecha.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No se encontraron facturas para la fecha seleccionada.</p>
}


<div class="alert alert-info" role="alert">
    <strong>Total de todas las facturas del día:</strong>
    @ViewBag.TotalDiario.ToString()
</div>