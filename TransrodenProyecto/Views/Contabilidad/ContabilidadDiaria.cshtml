@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Contabilidad Diaria";
}
@using TransrodenProyecto.Models
@model IEnumerable<TransrodenProyecto.Models.Facturacion>



    <!-- Contabilidad -->
    <!-- Contenido Principal -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow-lg">
                    <div class="card-body">
                        <h2 class="card-title text-center mb-4">Contabilidad Diaria</h2>

                        <!-- Formulario de búsqueda -->
                        <form asp-action="ContabilidadDiaria" method="get" class="mb-4">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label for="fechaDia" class="form-label">Seleccionar Fecha:</label>
                                        <input type="date" id="fechaDia" name="fechaDia"
                                               value="@ViewBag.FechaDia.ToString("yyyy-MM-dd")"
                                               class="form-control shadow-sm" required />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-search me-2"></i>Consultar
                                    </button>
                                </div>
                            </div>
                        </form>

                        @if (Model != null && Model.Any())
                        {
                            <div class="alert alert-info shadow-sm">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <h5 class="mb-0">Fecha: @ViewBag.FechaDia.ToShortDateString()</h5>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <h5 class="mb-0">Total del día: @ViewBag.TotalDiario.ToString("C")</h5>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive mt-4">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center">ID</th>
                                            <!--<th class="text-center">Cantidad</th>-->
                                            <th class="text-center">Precio Unitario</th>
                                            <th class="text-center">Total</th>
                                            <th class="text-center">Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var factura in Model)
                                        {
                                            <tr>
                                                <td class="text-center">@factura.Id_Facturacion</td>
                                                
                                                <td class="text-end">@factura.Precio.ToString("C")</td>
                                                <td class="text-end">@factura.Total.ToString("C")</td>
                                                <td class="text-center">@factura.Fecha.ToShortDateString()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="alert alert-success mt-4 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>Total de todas las facturas del día:</strong>
                                    <span class="h5 mb-0">@ViewBag.TotalDiario.ToString("C")</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning shadow-sm">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                No se encontraron facturas para la fecha seleccionada.
                            </div>
                        }

                        <!--  Generación de PDF   -->
                        <!-- 1. Botón (colócalo donde desees dentro de tu container mt-5) -->
                        <div class="text-center mt-3">
                            <button onclick="generatePDF()" class="btn btn-primary">
                                <i class="fas fa-file-pdf me-2"></i>Descargar PDF
                            </button>
                        </div>

                        <!-- 2. Scripts necesarios para el PDF -->
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

                        <!-- 3. Función para generar el PDF -->
                        <script>
                            function generatePDF() {
                                const { jsPDF } = window.jspdf;
                                const container = document.querySelector('.container.mt-5');

                                if (!container) {
                                    alert('No se encontró el contenedor especificado');
                                    return;
                                }

                                // Mostrar indicador de carga
                                const spinner = document.getElementById('spinner');
                                spinner.classList.add('show');

                                html2canvas(container, {
                                    scale: 2, // Mejor calidad
                                    logging: false,
                                    useCORS: true,
                                    allowTaint: true
                                }).then(canvas => {
                                    spinner.classList.remove('show');

                                    const imgData = canvas.toDataURL('image/png');
                                    const pdf = new jsPDF('p', 'mm', 'a4');

                                    const imgProps = pdf.getImageProperties(imgData);
                                    const pdfWidth = pdf.internal.pageSize.getWidth();
                                    const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                                    try {
                                        pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
                                        pdf.save('contabilidad-diaria.pdf');
                                    } catch (error) {
                                        console.error('Error al generar el PDF:', error);
                                        alert('Hubo un error al generar el PDF. Por favor, intente nuevamente.');
                                    }
                                }).catch(error => {
                                    spinner.classList.remove('show');
                                    console.error('Error al capturar el contenido:', error);
                                    alert('Hubo un error al capturar el contenido. Por favor, intente nuevamente.');
                                });
                            }
                        </script>

                        <!--  Generación de PDF   -->

                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Fin Contenido Principal -->