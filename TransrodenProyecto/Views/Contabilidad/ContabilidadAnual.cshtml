@using TransrodenProyecto.Models
@model TransrodenProyecto.Models.Facturacion
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Facturación por Año";
    var contabilidadMensual = ViewBag.ContabilidadMensual as Dictionary<int, List<TransrodenProyecto.Models.Facturacion>>;
    int yearCont = ViewBag.YearCont;
    double totalAnual = ViewBag.TotalAnual;
}


    <!-- Contabilidad -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow-lg">
                    <div class="card-body">
                        <h2 class="card-title text-center mb-4">Facturación por Año</h2>

                        <!-- Formulario de búsqueda -->
                        <form method="get" action="@Url.Action("ContabilidadAnual")" class="mb-4">
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label for="año" class="form-label">Seleccione el año:</label>
                                        <input type="number" id="año" name="yearCont"
                                               value="@yearCont" min="2000" max="@DateTime.Now.Year"
                                               class="form-control shadow-sm" required />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-search me-2"></i>Mostrar Facturación
                                    </button>
                                </div>
                            </div>
                        </form>

                        <!-- Alerta con la información del año -->
                        <div class="alert alert-info shadow-sm">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h5 class="mb-0">Año: @yearCont</h5>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <h5 class="mb-0">Total anual: @totalAnual.ToString("C")</h5>
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de datos -->
                        <div class="table-responsive mt-4">
                            <table class="table table-hover table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center">Mes</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-center">Total de ganancias</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <tr>
                                            <td class="text-center">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</td>
                                            @if (contabilidadMensual != null && contabilidadMensual.ContainsKey(i))
                                            {
                                                var facturacionesMes = contabilidadMensual[i];
                                                int cantidadMensual = 0;
                                                double totalMensual = 0;
                                                foreach (var factura in facturacionesMes)
                                                {
                                                    int cantidad;
                                                    if (int.TryParse(factura.Cantidad, out cantidad))
                                                    {
                                                        cantidadMensual += cantidad;
                                                    }
                                                    totalMensual += factura.Total;
                                                }
                                                <td class="text-center">@cantidadMensual</td>
                                                <td class="text-end">@totalMensual.ToString("C")</td>
                                            }
                                            else
                                            {
                                                <td class="text-center text-muted">No Hubieron Pedidos</td>
                                                <td class="text-end text-muted">No Hubieron Ganancias</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Total anual en alerta -->
                        <div class="alert alert-success mt-4 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>Total del año:</strong>
                                <span class="h5 mb-0">@totalAnual.ToString("C")</span>
                            </div>
                        </div>

                        <!-- Botón de PDF -->
                        <div class="text-center mt-3">
                            <button onclick="generatePDF()" class="btn btn-primary">
                                <i class="fas fa-file-pdf me-2"></i>Descargar PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts para PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        function generatePDF() {
            const { jsPDF } = window.jspdf;
            const container = document.querySelector('.container.mt-5');

            if (!container) {
                alert('No se encontró el contenedor especificado');
                return;
            }

            const spinner = document.getElementById('spinner');
            spinner.classList.add('show');

            html2canvas(container, {
                scale: 2,
                logging: false,
                useCORS: true,
                allowTaint: true
            }).then(canvas => {
                spinner.classList.remove('show');

                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');

                const imgProps = pdf.getImageProperties(imgData);
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                try {
                    pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
                    pdf.save('contabilidad-anual.pdf');
                } catch (error) {
                    console.error('Error al generar el PDF:', error);
                    alert('Hubo un error al generar el PDF. Por favor, intente nuevamente.');
                }
            }).catch(error => {
                spinner.classList.remove('show');
                console.error('Error al capturar el contenido:', error);
                alert('Hubo un error al capturar el contenido. Por favor, intente nuevamente.');
            });
        }
    </script>
    <!-- FIN de Contabilidad -->
    