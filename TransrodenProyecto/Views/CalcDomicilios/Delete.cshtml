@model TransrodenProyecto.Calculadora.CalcDomicilio
@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">
    <h3>Estas seguro de eliminar este domicilio?</h3>
    <br>
    <div>
        <h2 class="text-center">Borrar Domicilio</h2>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Nombre)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Costo)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Costo)
            </dd>

        </dl>
        <br>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Borrar" class="btn btn-danger" /> |
                <a href="@Url.Action("AdminCalculadora", "AdminCalculadora")" class="btn btn-primary btn-sm">Regresar</a>
            </div>
        }
    </div>
</div>
