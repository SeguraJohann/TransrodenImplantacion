<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <!-- Nav -->
    @if (Session["UsuarioRol"] != null)
    {
        var rol = (TransrodenProyecto.Models.Rol)Session["UsuarioRol"];
        var sedeUsuario = (TransrodenProyecto.Models.Sede)Session["Sede"];

        if (rol == TransrodenProyecto.Models.Rol.Administrador)   //Administrador
        {
            @Html.Partial("~/Views/Shared/_AdminNav.cshtml") //Administrador
        }
        else if (rol == TransrodenProyecto.Models.Rol.Bodeguero)    // Bodeguero
        {
            @Html.Partial("~/Views/Shared/_BodegueroNav.cshtml")// Bodeguero
        }
        else if (rol == TransrodenProyecto.Models.Rol.Transportista) //Transportista
        {
            @Html.Partial("~/Views/Shared/_TransportistaNav.cshtml") //Transportista
        }
        else                                                         // Clientes
        {
            @Html.Partial("~/Views/Shared/_ClienteNav.cshtml") // Clientes
        }
    }
    else
    {
        @Html.Partial("~/Views/Shared/_SinSesionNav.cshtml")// Navegación sin sesión
    }
    <!-- Nav -->
    <!-- Body-->
    <!--<div class="container">-->
    @RenderBody()
    <!--</div>-->
    <!-- Body-->
    <!-- Footer -->
    @if (Session["UsuarioRol"] != null)
    {
        var rol = (TransrodenProyecto.Models.Rol)Session["UsuarioRol"];
        var sedeUsuario = (TransrodenProyecto.Models.Sede)Session["Sede"];

        if (rol == TransrodenProyecto.Models.Rol.Administrador)   //Administrador
        {
            @Html.Partial("~/Views/Shared/_FooterAdmin.cshtml") //Administrador
        }
        else if (rol == TransrodenProyecto.Models.Rol.Bodeguero)    // Bodeguero
        {
            @Html.Partial("~/Views/Shared/_FooterBodeguero.cshtml")// Bodeguero
        }
        else if (rol == TransrodenProyecto.Models.Rol.Transportista) //Transportista
        {
            @Html.Partial("~/Views/Shared/_FooterTransportista.cshtml") //Transportista
        }
        else                                                         // Clientes
        {
            @Html.Partial("~/Views/Shared/_FooterCliente.cshtml") // Clientes
        }
    }
    else
    {
        @Html.Partial("~/Views/Shared/_FooterSinSesion.cshtml")// Footer para usuarios sin sesión
    }
    <!-- Footer -->

</body>
</html>