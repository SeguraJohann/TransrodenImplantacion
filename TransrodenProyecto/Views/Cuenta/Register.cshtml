@model TransrodenProyecto.Models.Usuario

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <!-- Registro Clientes Interfaz -->
    <div class="container-fluid bg-light py-5">
        <div class="container py-5">
            <div class="row g-5 align-items-center">
                <div class="col-xl-6 wow fadeInLeft" data-wow-delay="0.2s">
                    <div class="h-100">
                        <div class="mb-5">
                            <h1 class="display-4 mb-0 text-center" style="color: cornflowerblue">Registrarse</h1>
                        </div>

                        @using (Html.BeginForm("Register", "Cuenta", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                @Html.LabelFor(m => m.Nombre)
                                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Nombre)
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Apellidos)
                                @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Apellidos)
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Cedula)
                                @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Cedula)
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Correo)
                                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Correo)
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Clave)
                                @Html.PasswordFor(m => m.Clave, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Clave)
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Telefono)
                                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Telefono)
                            </div>

                            <!-- Mensaje de registro completado -->
                            <div id="mensajeRegistro" style="display:none; margin-top:10px;" class="alert alert-success text-center">
                                Registro completado
                            </div>

                            <!-- Botón para registrarse -->
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary" onclick="mostrarMensaje()">Registrar</button>
                            </div>

                            <script>
                                function mostrarMensaje() {
                                    var mensaje = document.getElementById("mensajeRegistro");
                                    mensaje.style.display = "block";

                                    // Mostrar el mensaje durante 3 segundos, luego redirigir




                                }
                            </script>
                        }

                    </div>
                </div>

                <div class="col-xl-6 wow fadeInRight" data-wow-delay="0.4s">
                    <img src="~/Content/assets/img/carousel-2.png" class="img-fluid w-100" alt="Registro de clientes">
                    <div class="text-center">
                        <h2 class="display-4 mb-0" style="color: red">Regístrese ahora</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Registro Clientes Interfaz -->