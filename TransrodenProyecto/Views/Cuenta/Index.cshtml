@model TransrodenProyecto.Models.Usuario

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<body>

    <div class="login-outer-container">
        <div class="container d-flex align-items-center justify-content-center min-vh-50 py-5 login-container">
            <div class="row justify-content-center w-100">
                <div class="col-lg-6 col-md-8">
                    <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
                        <h2 class="text-center mb-4">Mi Perfil</h2>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        @using (Html.BeginForm("Index", "Cuenta", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.Id_Usuario)
                            @Html.HiddenFor(model => model.Rol)
                            @Html.HiddenFor(model => model.Sede)

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Nombre, "Nombre", new { @class = "form-label" })
                                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Apellidos, "Apellidos", new { @class = "form-label" })
                                @Html.EditorFor(model => model.Apellidos, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Apellidos, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Cedula, "Cédula", new { @class = "form-label" })
                                @Html.EditorFor(model => model.Cedula, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Cedula, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Correo, "Correo", new { @class = "form-label" })
                                @Html.EditorFor(model => model.Correo, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Correo, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Telefono, "Teléfono", new { @class = "form-label" })
                                @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(model => model.Clave, "Contraseña", new { @class = "form-label" })
                                @Html.Password("Clave", null, new
                                {
                                    @class = "form-control",
                                    placeholder = "Dejar en blanco para mantener la contraseña actual",
                                    data_val = "false"
                                })
                                <small class="text-muted">Dejar en blanco si no desea cambiar la contraseña</small>
                            </div>

                            <div class="form-check mb-4">
                                @Html.CheckBoxFor(model => model.NotifCli, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.NotifCli, "Recibir notificaciones", new { @class = "form-check-label" })
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn w-100" style="background-color: var(--bg-positivo); color: white;">Guardar Cambios</button>
                                @Html.ActionLink("Volver", "Index", "Home", null, new { @class = "btn w-100", @style = "background-color: var(--bg-negativo); color: white;" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")
</body>
