@model TransrodenProyecto.Calculadora.CalcCaja

@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <div class="container mt-5">
        <h3>Estas seguro de eliminar esta caja?</h3>
        <br>
        <div>
            <h4 class="text-center">Eliminar Caja</h4>
            <hr />
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Tipo)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Tipo)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.Costo)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Costo)
                </dd>

            </dl>
            <br>
            <br>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions no-color">
                    <input type="submit" value="Borrar" class="btn btn-danger" /> |
                    <a href="@Url.Action("AdminCalculadora", "AdminCalculadora")" class="btn btn-primary btn-sm">Regresar</a>
                </div>
            }
        </div>
        <br>
        <br>
    </div>
    