
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Imagen de Banner -->
<div class="container-fluid bg-breadcrumb">
    <div class="container text-center py-5" style="max-width: 900px;">
        <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Experiencia, Servicio y Calidad!</h4>
        <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
            <li class="breadcrumb-item"><a href="index.html">Inicio</a></li>
            <li class="breadcrumb-item"><a href="#">Nosotros</a></li>
        </ol>
    </div>
</div>

<!-- Feature Start -->
<div class="container-fluid feature bg-light pb-5">
    <div class="container pb-5">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
            <h4 class="text-primary">Nosotros</h4>
            <h1 class="display-4 mb-4">Transroden Express SA los expertos en encomiendas</h1>
            <p class="mb-0">
                Transroden es una empresa dedicada a la gestión de envíos de paquetes.
                Su objetivo principal es ofrecer un servicio eficiente y confiable para el transporte de productos,
                 garantizando un seguimiento preciso y una entrega segura a sus clientes.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-6 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                <div class="feature-item p-4 pt-0">
                    <div class="feature-icon p-4 mb-4">
                        <i class="far fa-handshake fa-3x"></i>
                    </div>
                    <h4 class="mb-4">Confianza</h4>
                    <p class="mb-4">
                        En Transroden, nos comprometemos con la seguridad, rapidez y eficiencia en cada envío. brindando tranquilidad y confianza a nuestros clientes.

                    </p>

                </div>
            </div>
            <div class="col-md-6 col-lg-6 col-xl-3 wow fadeInUp" data-wow-delay="0.4s">
                <div class="feature-item p-4 pt-0">
                    <div class="feature-icon p-4 mb-4">
                        <i class="fa fa-dollar-sign fa-3x"></i>
                    </div>
                    <h4 class="mb-4">Responsabilidad</h4>
                    <p class="mb-4">
                        Transroden es responsable porque garantiza la seguridad y el manejo adecuado de cada paquete. Ofreciendo un servicio transparente.
                    </p>

                </div>
            </div>
            <div class="col-md-6 col-lg-6 col-xl-3 wow fadeInUp" data-wow-delay="0.6s">
                <div class="feature-item p-4 pt-0">
                    <div class="feature-icon p-4 mb-4">
                        <i class="fa fa-bullseye fa-3x"></i>
                    </div>
                    <h4 class="mb-4">Puntualidad</h4>
                    <p class="mb-4">
                        Nos comprometemos a entregar cada paquete en el tiempo acordado, optimizando procesos para garantizar envíos eficientes.
                    </p>

                </div>
            </div>
            <div class="col-md-6 col-lg-6 col-xl-3 wow fadeInUp" data-wow-delay="0.8s">
                <div class="feature-item p-4 pt-0">
                    <div class="feature-icon p-4 mb-4">
                        <i class="fa fa-headphones fa-3x"></i>
                    </div>
                    <h4 class="mb-4">Atencion al cliente</h4>
                    <p class="mb-4">
                        Ofrecemos una atención al cliente rápida y eficiente, brindando informacion en cada etapa del envío.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Feature End -->
<!-- Testimonial Start -->
<div class="container-fluid testimonial pb-5">
    <div class="container pb-5">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
            <h4 class="text-primary">Historia</h4>
            <h1 class="display-4 mb-4">Un poco mas sobre nosotros</h1>
            <p class="mb-0">

                 Transroden es una empresa de trasporte de encomiendas San José -Pérez Zeledón- Buenos Aires - San Vito, le agradece a nuestros clientes la fidelidad y la confianza a nuestra empresa.
            </p>
        </div>
        <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.2s">
            <div class="testimonial-item bg-light rounded">
                <div class="row g-0">
                    <div class="col-4 col-lg-4 col-xl-3" style="height: 200px; width: 350px;">
                        <div class="h-100">
                            <img src="~/Content/assets/img/historia1.jpg" class="img-fluid h-100 rounded" style="object-fit: cover;" alt="">
                        </div>
                    </div>
                    <div class="col-8 col-lg-8 col-xl-9">
                        <div class="d-flex flex-column my-auto text-start p-4">
                            <h4 class="text-dark mb-0">Origenes</h4>


                            <p class="mb-0">
                                En Transroden llevamos mas de 30 años de experiencia nos comprometen a brindar un servicio excelente y eficiente.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="testimonial-item bg-light rounded">
                <div class="row g-0">
                    <div class="col-4 col-lg-4 col-xl-3" style="height: 200px; width: 300px;">
                        <div class="h-100">
                            <img src="~/Content/assets/img/historia2.jpg" class="img-fluid h-100 rounded" style="object-fit: cover;" alt="">
                        </div>
                    </div>
                    <div class="col-8 col-lg-8 col-xl-9">
                        <div class="d-flex flex-column my-auto text-start p-4">
                            <h4 class="text-dark mb-0">Nosotros en PZ</h4>


                            <p class="mb-0">
                                Transroden ahora dispone de una sucursal en Perez Zeledon ubicada a 50 metros sur de las antiguas panaderías,Pavones, San Isidro, Pérez Zeledón.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="testimonial-item bg-light rounded">
                <div class="row g-0">
                    <div class="col-4 col-lg-4 col-xl-3" style="height: 200px; width: 300px;">
                        <div class="h-100">
                            <img src="~/Content/assets/img/historia3.jpg" class="img-fluid h-100 rounded" style="object-fit: cover;" alt="">
                        </div>
                    </div>
                    <div class="col-8 col-lg-8 col-xl-9">
                        <div class="d-flex flex-column my-auto text-start p-4">
                            <h4 class="text-dark mb-0">Localidad</h4>


                            <p class="mb-0">
                                Nuestra sucursal principal se ubica en Calle 16, Bo. México, San José, Costa Rica.
                                Estamos disponibles de 7:30am a 4:30pm
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Testimonial End -->
