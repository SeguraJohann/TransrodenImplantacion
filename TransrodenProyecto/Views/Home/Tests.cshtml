@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-outer-container">
    <div class="container py-5 login-container">
        <div class="bg-white rounded p-4 p-sm-5 shadow-sm">
            <h2 class="text-center mb-4">Guía de Estilos</h2>

            <!-- Colores -->
            <section class="mb-5">
                <h3>Colores del Sistema</h3>
                <div class="d-flex gap-3 mb-3">
                    <div class="p-4 rounded" style="background-color: var(--logo-blue);">
                        <span class="text-white">--logo-blue</span>
                    </div>
                    <div class="p-4 rounded" style="background-color: var(--bg-dark);">
                        <span class="text-white">--bg-dark</span>
                    </div>
                    <div class="p-4 rounded" style="background-color: var(--bg-positivo);">
                        <span class="text-white">--bg-positivo</span>
                    </div>
                    <div class="p-4 rounded" style="background-color: var(--bg-negativo);">
                        <span class="text-white">--bg-negativo</span>
                    </div>
                </div>
            </section>

            <!-- Botones -->
            <section class="mb-5">
                <h3>Botones</h3>
                <h4 class="mt-3">Botones Básicos</h4>
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-primary">btn-primary</button>
                    <button class="btn btn-light">btn-light</button>
                    <button class="btn btn-dark">btn-dark</button>
                </div>

                <h4 class="mt-3">Botones Cuadrados</h4>
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-primary btn-square">
                        <i class="fas fa-home"></i>
                    </button>
                    <button class="btn btn-primary btn-sm-square">
                        <i class="fas fa-user"></i>
                    </button>
                    <button class="btn btn-primary btn-md-square">
                        <i class="fas fa-cog"></i>
                    </button>
                    <button class="btn btn-primary btn-lg-square">
                        <i class="fas fa-bell"></i>
                    </button>
                    <button class="btn btn-primary btn-xl-square">
                        <i class="fas fa-star"></i>
                    </button>
                </div>

                <h4 class="mt-3">Botones de Acción</h4>
                <div class="d-flex gap-2">
                    <button class="btn btn-positivo w-100">Botón Positivo</button>
                    <button class="btn w-100" style="background-color: var(--bg-negativo); color: white;">Botón Negativo</button>
                </div>
            </section>

            <!-- Formularios -->
            <section class="mb-5">
                <h3>Elementos de Formulario</h3>
                <div class="mb-3">
                    <label class="form-label">Input Estándar</label>
                    <input type="text" class="form-control" placeholder="Placeholder texto">
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="checkboxDemo">
                    <label class="form-check-label" for="checkboxDemo">
                        Checkbox con estilo
                    </label>
                </div>
            </section>

            <!-- Alertas -->
            <section class="mb-5">
                <h3>Alertas</h3>
                <div class="alert alert-success mb-2">
                    Alerta de éxito
                </div>
                <div class="alert alert-danger">
                    Alerta de error
                </div>
            </section>

            <!-- Links -->
            <section class="mb-5">
                <h3>Enlaces</h3>
                <a href="#" class="forgot-password">Enlace tipo forgot-password</a>
            </section>

            <!-- Contenedores -->
            <section>
                <h3>Contenedores</h3>
                <div class="bg-white rounded p-3 shadow-sm mb-3">
                    Contenedor con sombra suave
                </div>
                <div class="bg-light rounded p-3">
                    Contenedor con fondo claro
                </div>
            </section>

            <!-- CSS -->
            <section class="mt-5">
                <h3>Código CSS de los Botones</h3>
                <pre class="bg-light p-3 rounded">
}</pre>
            </section>
        </div>
    </div>
</div>

<!-- Estilos necesarios para la demostración -->


<!-- Font Awesome -->
<link rel="stylesheet" href=" https: //cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css