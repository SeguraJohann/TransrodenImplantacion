@model TransrodenProyecto.ViewModels.CamionKmViewModel
@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div>
        <h2 class="text-center">Camión</h2>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                Camionero asignado
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CamionActual.Usuario.Nombre)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.CamionActual.Marca)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CamionActual.Marca)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.CamionActual.Modelo)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CamionActual.Modelo)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.CamionActual.TipoCarga)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CamionActual.TipoCarga)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.CamionActual.Disponible)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.CamionActual.Disponible)
            </dd>
        </dl>
    </div>

    <div>
        <h4>Historial de Kilometraje</h4>
        <br>
        <table class="table">
            <thead>
                <tr>
                    <th>Kilometraje Actual</th>
                    <th>Kilometraje Anterior</th>
                    <th>Transportista</th>
                    <th>Feche de Registro</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kilometro in Model.Kilometros)
                {
                    <tr>
                        <td>@kilometro.Km_actual</td>
                        <td>@kilometro.Km_anterior</td>
                        <td>@kilometro.Transportista</td>
                        <td>@kilometro.Registro.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <p>
        @Html.ActionLink("Editar", "Edit", new { id = Model.CamionActual.Id_Camion }, new { @class = "btn btn-success" }) |
        @Html.ActionLink("Regresar a la lista", "Index")
    </p>

</div>
