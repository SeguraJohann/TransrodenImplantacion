@model TransrodenProyecto.Models.Camion
@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">
    <h2 class="text-center">Camion</h2>
    <br>
    <div>
        <h4>Estas seguro de eliminar este camion?</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.Usuario.Nombre)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Usuario.Nombre)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Marca)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Marca)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Modelo)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Modelo)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.TipoCarga)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.TipoCarga)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Disponible)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Disponible)
            </dd>

        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Borrar" class="btn btn-danger" /> |
                @Html.ActionLink("Regresar a la lista", "Index")
            </div>
        }
    </div>
    <br>
</div>
