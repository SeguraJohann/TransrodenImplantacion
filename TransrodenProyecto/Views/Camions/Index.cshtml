@model IEnumerable<TransrodenProyecto.Models.Camion>
@using TransrodenProyecto.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">


    <h2 class="text-center">Lista de Camiones</h2>


    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("Create", "Camions")" class="btn btn-danger">
            <i class="fa fa-truck"></i> Agregar Camion
        </a>
    </div>


    <table class="table">
        <tr>
            <th>
                Camionero Asignado
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Marca)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Modelo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoCarga)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Disponible)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Usuario.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Marca)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Modelo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TipoCarga)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Disponible)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id_Camion }, new { @class = "btn btn-success" }) |
                    @Html.ActionLink("Detalles", "Details", new { id = item.Id_Camion }, new { @class = "btn btn-primary" }) |
                    @Html.ActionLink("Borrar", "Delete", new { id = item.Id_Camion }, new { @class = "btn btn-danger" })
                    <!--
                    <a href="@Url.Action("KmRegistro", "Kilometrajes", new { id = item.Id_Camion})" class="btn btn-primary">
                        Agregar Kilometraje
                    </a>
                        -->
                </td>
            </tr>
        }

    </table>
    <br>
</div>
