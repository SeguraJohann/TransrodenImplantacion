
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



    <!-- Dashboard Start -->
    <div class="container-fluid blog py-5">
        <div class="container py-5">
            <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
                <h4 class="text-primary">Transroden Express SA</h4>
                <h1 class="display-4 mb-4">Centro de asignaciones</h1>
                <p class="mb-0">
                    Esta es una vista donde un usuario transportista puede ver que cargas tiene asigandas, asi como los envios domicilios pendientes de entrega
                </p>
            </div>
            <div class="row g-4 justify-content-center">
                <div class="col-lg-6 col-xl-4 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/carga.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Cargas</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">
                            <a href="#" class="h4 d-inline-block mb-3">Ver Cargas Asignadas</a>
                            <p class="mb-3">Aqui se muestran las cargas asignadas para el transportista</p>
                            <div>
                                <button onclick="location.href='@Url.Action("CargasTransportista", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-lg-6 col-xl-4 wow fadeInUp" data-wow-delay="0.4s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/paquete.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Envios</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">
                            <a href="#" class="h4 d-inline-block mb-3">Ver Envios Domicilios Asignados</a>
                            <p class="mb-3">Aqui se muestran los envios domicilios asignados para el transportista</p>
                            <div>
                                <button onclick="location.href='@Url.Action("EnviosTransportista", "PaquetesEnviosController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-lg-6 col-xl-4 wow fadeInUp" data-wow-delay="0.6s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/historialimagen.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Historial</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">
                            <a href="#" class="h4 d-inline-block mb-3">Historial de Cargas y Paquetes</a>
                            <p class="mb-3">Aqui se muestra un historial de cargas y envios realizados</p>
                            <div>
                                <button onclick="location.href='@Url.Action("CargasEntregadasTransportista", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Dashboard End -->
