@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">


    <h2 class="text-center">Paquetes de la Carga</h2>


    <div class="container mt-5">
        <h4>Transportista: @Model.Cargas.First().Usuario.Nombre</h4>
        <h4>Estado: @Model.Cargas.First().Estado.ToString()</h4>
        <h4>Paquetes Asignados: @Model.Cargas.First().NumeroPaquetes</h4>
        <br>
        <table class="table mt-4">
            <thead>
                <tr>
                    <th>Número de Rastreo</th>
                    <th>Emisor</th>
                    <th>Receptor</th>
                    <th>Estado</th>
                    <th>Detalles del Paquete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var paquete in Model.Paquetes)
                {
                    <tr>
                        <td>@paquete.NumeroRastreo</td>
                        <td>@paquete.NombreEmisor</td>
                        <td>@paquete.NombreReceptor</td>
                        <td>@paquete.Estado.ToString()</td>
                        <td>
                            <a href="@Url.Action("Details", "Paquetes", new { id = paquete.Id_Paquete })" class="btn btn-primary">
                                Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
