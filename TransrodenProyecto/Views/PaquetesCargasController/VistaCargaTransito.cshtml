@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var sedeUser = Session["Sede"] != null ? (Sede)Session["Sede"] : Sede.SanJose;
}

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<div class="container-fluid bg-light py-4">
    <!-- Header Section -->
    <div class="text-center mb-4">
        <h1 class="display-4 mb-4">Cargas y Envíos Domicilio en Tránsito</h1>
    </div>
    <br>
    @if (Session["Usuario"] != null)
    {
        // Enlace para regresar a la vista anterior
        <a href="javascript:void(0);" onclick="goBack()" class="btn btn-success">Regresar</a>
        <script>
    function goBack() {
        if (document.referrer) {
            window.history.back();
        } else {
            @*window.location.href = '@Url.Action("DefaultAction", "DefaultController")';*@
            if (sedeUsuario == Sede.SanJose) {
                urlEnvios = Url.Action("DomicilioSJCarga", "PaquetesEnviosController");
            }
            else if (sedeUsuario == Sede.PerezZeledon) {
                urlEnvios = Url.Action("DomicilioPZCarga", "PaquetesEnviosController");
            }
            else {
                urlEnvios = "#";
            }
        }
    }
        </script>
    }
    else
    {
        <a href="@Url.Action("Login", "Cuenta")" class="btn btn-danger">
            <span class="d-block"><i class="fas fa-user"></i></span>
            Login
        </a>
    }
    <br>
    <br>
    <div class="row g-4">
        <!-- Cargas en Tránsito Section - First Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-truck-moving me-2"></i>Cargas en Tránsito
                    </h3>
                </div>


                @if (TempData["ErrorMessageGlobalCarga"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessageGlobalCarga"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessageGlobalCarga"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Éxito:</strong> @TempData["SuccessMessageGlobalCarga"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }



                <div class="card-body">
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-hover align-middle mb-0 bg-white">
                            <thead class="bg-lightt">
                                <tr>
                                    <th>Id Carga</th>
                                    <th>Origen</th>
                                    <th>Transportista</th>
                                    <th>Estado</th>
                                    <th>Paquetes</th>
                                    <th>Acciones</th>
                                    <th>Cambiar Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var carga in Model.Cargas)
                                {
                                    <tr>
                                        <td><span class="badge" style="background-color: var(--bg-info); color: white;">@carga.Id_Carga</span></td>
                                        <td>@carga.Origen</td>
                                        <td>@carga.Usuario.Nombre</td>
                                        <td><span class="badge" style="background-color: var(--bg-dark); color: white;">@carga.Estado.ToString()</span></td>
                                        <td>
                                            <span class="badge" style="background-color: var(--bg-info); color: white;">@carga.NumeroPaquetes</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("CargaPaquetesView", "PaquetesCargasController", new { idCarga = carga.Id_Carga })"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="fa fa-eye me-1"></i>Ver Paquetes
                                            </a>
                                        </td>
                                        <td>
                                            @using (Html.BeginForm("ActualizarEstadoCargaGlobal", "PaquetesCargasController", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("idCarga", carga.Id_Carga)
                                                <div class="input-group input-group-sm">
                                                    <select name="nuevoEstado" class="form-select">
                                                        <option value="">Estado</option>
                                                        <option value="BodegaSJ">BodegaSJ</option>
                                                        <option value="BodegaPZ">BodegaPZ</option>
                                                        @*<option value="EnTransito">EnTransito</option>*@
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-primary">
                                                        <i class="fa fa-sync-alt"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Envíos en Tránsito Section - Second Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-shipping-fast me-2"></i>Envíos Domicilio en Tránsito
                    </h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-hover align-middle mb-0 bg-white">
                            <thead class="bg-lightt">
                                <tr>
                                    <th>Id Envío</th>
                                    <th>Transportista</th>
                                    <th>Estado</th>
                                    <th>Paquetes</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var envio in Model.Envios)
                                {
                                    <tr>
                                        <td><span class="badge" style="background-color: var(--bg-info); color: white;">@envio.Id_Envio</span></td>
                                        <td>@envio.Usuario.Nombre</td>
                                        <td><span class="badge" style="background-color: var(--bg-dark); color: white;">@envio.Estado.ToString()</span></td>
                                        <td>
                                            <span class="badge" style="background-color: var(--bg-info); color: white;">@envio.NumeroPaquetes</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("EnvioPaquetes", "PaquetesEnviosController", new { idEnvio = envio.Id_Envio })"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="fa fa-eye me-1"></i>Ver Paquetes
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>