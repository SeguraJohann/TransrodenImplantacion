@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    @{
        var sedeUser = Session["Sede"] != null ? (Sede)Session["Sede"] : Sede.SanJose;
    }


    <div class="container mt-5">
        <h1 class="text-center">Cargas y Envios Domicilio en Transito</h1>
        <br>
        <br />

        <h2>Cargas en Transito!!</h2>
        <br>

        <table class="table">
            <thead>
                <tr>
                    <th>Id Carga</th>
                    <th>Origen</th>
                    <th>Transportista</th>
                    <th>Estado</th>
                    <th>Paquetes Asignados</th>
                    <th>Ver Paquetes</th>
                    <th>Cambiar Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var carga in Model.Cargas)
                {
                    <tr>
                        <td>@carga.Id_Carga</td>
                        <td>@carga.Origen</td>
                        <td>@carga.Usuario.Nombre</td>
                        <td>@carga.Estado.ToString()</td>
                        <td>@carga.NumeroPaquetes</td>
                        <td>
                            <a href="@Url.Action("CargaPaquetesView", "PaquetesCargasController", new { idCarga = carga.Id_Carga })" class="btn btn-success">
                                Ver Paquetes
                            </a>
                        </td>
                        <td>
                            @using (Html.BeginForm("ActualizarEstadoCargaGlobal", "PaquetesCargasController", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("idCarga", carga.Id_Carga)

                                <select name="nuevoEstado" class="form-control">
                                    <option value="">Estado</option>
                                    <option value="BodegaSJ">BodegaSJ</option>
                                    <option value="BodegaPZ">BodegaPZ</option>
                                    <option value="EnTransito">EnTransito</option>
                                </select>

                                <button type="submit" class="btn btn-primary mt-2">Actualizar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <br>
    </div>


    <br>

    <!-- Aqui van los envios en transito -->
    <div class="container mt-5">


        <h2>Envios Domicilio en Transito!!</h2>
        <br>

        <table class="table">
            <thead>
                <tr>
                    <th>Id Envio</th>
                    <th>Transportista</th>
                    <th>Estado</th>
                    <th>Paquetes Asignados</th>
                    <th>Ver Paquetes</th>
                    <!--<th>Cambiar Estado</th>-->
                </tr>
            </thead>
            <tbody>
                @foreach (var envio in Model.Envios)
                {
                    <tr>
                        <td>@envio.Id_Envio</td>
                        <td>@envio.Usuario.Nombre</td>
                        <td>@envio.Estado.ToString()</td>
                        <td>@envio.NumeroPaquetes</td>
                        <td>
                            <a href="@Url.Action("EnvioPaquetes", "PaquetesEnviosController", new { idEnvio = envio.Id_Envio })" class="btn btn-success">
                                Ver Paquetes
                            </a>
                        </td>
                        <!--
                         <td>
                            @using (Html.BeginForm("ActualizarEstadoEnvioGlobal", "PaquetesEnviosController", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("idEnvio", envio.Id_Envio)

                                <select name="nuevoEstado" class="form-control">
                                    <option value="">Estado</option>
                                    <option value="BodegaSJ">BodegaSJ</option>
                                    <option value="BodegaPZ">BodegaPZ</option>
                                    <option value="EnTransito">EnTransito</option>
                                    <option value="Entregado">Entregado</option>
                                </select>

                                <button type="submit" class="btn btn-primary mt-2">Actualizar</button>
                            }
                        </td>
                        -->
                    </tr>

                }
            </tbody>
        </table>

    </div>


    <br>
    <br>

