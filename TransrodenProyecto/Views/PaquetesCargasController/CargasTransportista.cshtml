@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



    <div class="container mt-5">

        <!-- Cargas para enviar -->
        <h2 class="text-center">Cargas Asignadas</h2>
        <br>

        <table class="table">
            <thead>
                <tr>
                    <th>Id Carga</th>
                    <th>Transportista</th>
                    <th>Estado</th>
                    <th>Paquetes Asignados</th>
                    <th>Ver Paquetes</th>
                    <th>Cambiar Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var carga in Model.Cargas)
                {
                    <tr>
                        <td>@carga.Id_Carga</td>
                        <td>@carga.Usuario.Nombre</td>
                        <td>@carga.Estado.ToString()</td>
                        <td>@carga.NumeroPaquetes</td>
                        <td>
                            <a href="@Url.Action("CargaPaquetesViewTransp", "PaquetesCargasController", new { idCarga = carga.Id_Carga })" class="btn btn-success">
                                Ver
                            </a>
                        </td>
                        <td>
                            @using (Html.BeginForm("EstadoCargaTransp", "PaquetesCargasController", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("idCarga", carga.Id_Carga)

                                <select name="nuevoEstado" class="form-control">
                                    <option value="">Estado</option>
                                    <option value="Averia">Averia</option>
                                </select>

                                <button type="submit" class="btn btn-danger mt-2">Actualizar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    