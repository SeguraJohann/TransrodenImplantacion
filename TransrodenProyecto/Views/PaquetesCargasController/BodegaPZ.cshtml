@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <!-- Menu -->
    <div class="container-fluid blog py-5">
        <div class="container py-5">
            <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
                <h4 class="text-primary">Transroden Express SA</h4>
                <h1 class="display-4 mb-4">Bodega Perez Zeledón</h1>
                <p class="mb-0">
                    Aqui puedes ver 2 secciones, una donde se puede visualizar todos los paquetes almacenados en la bodega de Perez Zeledon y otra donde puedes ver los paquetes pendientes de que sean reclamados.
                </p>
            </div>
            <div class="row g-4 justify-content-center">
                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/carga.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Paquetes(Todos)</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">
                            <a href="#" class="h4 d-inline-block mb-3">Todos los Paquetes</a>
                            <p class="mb-3">Aqui muestra todos los paquetes que se encuentran en la Bodega de Perez Zeledon</p>
                            <div>
                                <button onclick="location.href='@Url.Action("PaquetesBodegaPZ", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/historialimagen.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Paquetes(Recoger)</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">

                            <a href="#" class="h4 d-inline-block mb-3">Paquetes para reclamar</a>
                            <p class="mb-3">Aqui se puede ver los paquete para entrega domicilio, asi como asignar los paquetes a una carga</p>
                            <div>
                                <button onclick="location.href='@Url.Action("PaquetesReclamoPZ", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/historialimagen.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Domicilio(No entregados)</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">

                            <a href="#" class="h4 d-inline-block mb-3">Paquetes rechazados</a>
                            <p class="mb-3">Aqui se puede ver los paquetes domicilio que no pudieron ser entregados</p>
                            <div>
                                <button onclick="location.href='@Url.Action("PaquetesRechazoPZ", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
    <!-- Menu -->
    