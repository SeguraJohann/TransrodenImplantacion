@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <!-- Menu -->
    <div class="container-fluid blog py-5">
        <div class="container py-5">
            <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
                <h4 class="text-primary">Transroden Express SA</h4>
                <h1 class="display-4 mb-4">Centro de tracking SJ</h1>
                <p class="mb-0">
                    Aqui puedes ver los paquetes que necesitan ser enviados a su destino, tambien puedes consultar los paquetes que se encuentran en la bodega y ademas de poder validar con en todo momento donde el estado de envio del paquete.
                </p>
            </div>
            <div class="row g-4 justify-content-center">
                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/carga.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Cargas</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">
                            <a href="#" class="h4 d-inline-block mb-3">Asignar Cargas</a>
                            <p class="mb-3">Aqui muestra los paquetes pendientes de envio hacia la Bodega de Perez Zeledon</p>
                            <div>
                                <button onclick="location.href='@Url.Action("AsignarPaqueteSJCarga", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/historialimagen.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Domicilio</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">

                            <a href="#" class="h4 d-inline-block mb-3">Entregas Domicilio</a>
                            <p class="mb-3">Aqui se puede ver los paquete para entrega domicilio, asi como asignar los paquetes a una carga</p>
                            <div>
                                <button onclick="location.href='@Url.Action("DomicilioSJCarga", "PaquetesEnviosController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/EnTransito.png" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Cargas en transito</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">

                            <a href="#" class="h4 d-inline-block mb-3">Ver cargas en transito</a>
                            <p class="mb-3">Aqui se muestran las cargas actualmente en transito tanto de SJ - PZ como Domicilio</p>
                            <div>
                                <button onclick="location.href='@Url.Action("VistaCargaTransito", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-md-6 col-lg-4 col-xl-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="blog-item">
                        <div class="blog-img">
                            <img src="~/Content/assets/img/Bodega.jpg" class="img-fluid rounded-top w-100" alt="">
                            <div class="blog-categiry py-2 px-4">
                                <span>Bodega</span>
                            </div>
                        </div>
                        <div class="blog-content p-4">

                            <a href="#" class="h4 d-inline-block mb-3">Bodega San Jose</a>
                            <p class="mb-3">Aqui puedes ver los paquetes almacenados en la bodega de San Jose</p>
                            <div>
                                <button onclick="location.href='@Url.Action("BodegaSJ", "PaquetesCargasController")'" type="submit" class="btn btn-primary w-100">Consultar</button>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
    <!-- Menu -->
