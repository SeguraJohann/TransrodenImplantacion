@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <h1 class="text-center">Envios Domicilios Perez Zeledon</h1>
    <br>
    <div class="d-flex justify-content-center ">
        <a href="@Url.Action("VistaCargaTransito", "PaquetesCargasController")" class="btn btn-primary">
            <i class="fa fa-truck"></i> Ver cargas en Transito
        </a>
    </div>
    <br>

    <div class="container mt-5">



        <div class="row">
            <!-- Lista de paquetes-->
            <div class="col-md-6">
                <h3>Paquetes Sin Carga Asignada</h3>

                @using (Html.BeginForm("AsignarPaqueteACargaPZ", "PaquetesCargasController", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Número de Rastreo</th>
                                <th>Emisor</th>
                                <th>Receptor</th>
                                <th>Estado</th>
                                <th>Asignar a Carga</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Paquetes.Count; i++)
                            {
                                var paquete = Model.Paquetes[i];
                                <tr>
                                    <td>@paquete.NumeroRastreo</td>
                                    <td>@paquete.NombreEmisor</td>
                                    <td>@paquete.NombreReceptor</td>
                                    <td>@paquete.Estado.ToString()</td>
                                    <td>
                                        @Html.Hidden($"PaqueteCargaAsignaciones[{i}].IdPaquete", paquete.Id_Paquete)

                                        <select name="PaqueteCargaAsignaciones[@i].IdCarga" class="form-control">
                                            <option value="">Seleccionar Carga</option>
                                            @foreach (var carga in Model.Cargas)
                                            {
                                                <option value="@carga.Id_Carga">
                                                    Carga: @carga.Id_Carga - Camionero: @carga.Usuario.Nombre
                                                </option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <button type="submit" class="btn btn-success">Asignar Carga</button>
                }
            </div>

            <!-- Cargas para enviar -->
            <div class="col-md-6">
                <h3>Cargas</h3>
                <br>
                <a href="@Url.Action("Create", "Cargas")" class="btn btn-danger">
                    <i class="fas fa-user-plus"></i> Agregar Carga
                </a>
                <br>
                <br>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Id Carga</th>
                            <th>Transportista</th>
                            <th>Estado</th>
                            <th>Paquetes Asignados</th>
                            <th>Ver Paquetes</th>
                            <th>Acciones</th>
                            <th>Cambiar Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var carga in Model.Cargas)
                        {
                            <tr>
                                <td>@carga.Id_Carga</td>
                                <td>@carga.Usuario.Nombre</td>
                                <td>@carga.Estado.ToString()</td>
                                <td>@carga.NumeroPaquetes</td>
                                <td>
                                    <a href="@Url.Action("CargaPaquetes", "PaquetesCargasController", new { idCarga = carga.Id_Carga })" class="btn btn-success">
                                        Ver
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "Cargas", new { id = carga.Id_Carga })" class="btn btn-primary">
                                        Editar
                                    </a>
                                    <a href="@Url.Action("Delete", "Cargas", new { id = carga.Id_Carga })" class="btn btn-danger">
                                        Borrar
                                    </a>
                                </td>
                                <td>
                                    @using (Html.BeginForm("ActualizarEstadoCargaPZ", "PaquetesCargasController", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("idCarga", carga.Id_Carga)

                                        <select name="nuevoEstado" class="form-control">
                                            <option value="">Estado</option>
                                            <option value="BodegaPZ">BodegaPZ</option>
                                            <option value="EnTransito">EnTransito</option>
                                        </select>

                                        <button type="submit" class="btn btn-danger mt-2">Actualizar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <br>
        <br>

        <!-- Cargas recibidas -->
        <div class="row">
            <div class="col-md-6 offset-md-6">
                <h3>Cargas Recibidas</h3>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Id Carga</th>
                            <th>Transportista</th>
                            <th>Estado</th>
                            <th>Paquetes Asignados</th>
                            <th>Ver Paquetes</th>
                            <th>Cambiar Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var carga in Model.CargasRecibidas)
                        {
                            <tr>
                                <td>@carga.Id_Carga</td>
                                <td>@carga.Usuario.Nombre</td>
                                <td>@carga.Estado.ToString()</td>
                                <td>@carga.NumeroPaquetes</td>
                                <td>
                                    <a href="@Url.Action("CargaPaquetesView", "PaquetesCargasController", new { idCarga = carga.Id_Carga })" class="btn btn-success">
                                        Ver
                                    </a>
                                </td>
                                <td>
                                    @using (Html.BeginForm("EstadoCargaPZ", "PaquetesCargasController", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("idCarga", carga.Id_Carga)

                                        <select name="nuevoEstado" class="form-control">
                                            <option value="">Estado</option>
                                            <option value="BodegaPZ">BodegaPZ</option>
                                            <option value="Recibido">Recibido</option>
                                        </select>

                                        <button type="submit" class="btn btn-danger mt-2">Actualizar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>






    