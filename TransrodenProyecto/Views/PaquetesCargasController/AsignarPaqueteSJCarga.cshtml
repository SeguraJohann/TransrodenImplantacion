@using TransrodenProyecto.Models
@model TransrodenProyecto.ViewModels.PaqueteCargaViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<div class="container-fluid bg-light py-4">
    <!-- Header Section -->
    <div class="text-center mb-4">
        <h1 class="display-4 mb-4">Cargas San José</h1>
        <a href="@Url.Action("VistaCargaTransito", "PaquetesCargasController")" class="btn btn-primary" style="color: white;">
            <i class="fa fa-truck me-2"></i> Ver cargas en Tránsito
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-box me-2"></i>Paquetes Sin Carga Asignada
                    </h3>
                    <div class="form-inline">
                        <label class="mr-2">Mostrar:</label>
                        <select class="form-control form-control-sm" onchange="changePageSize(this.value)">
                            <option value="5" @(Model.PageSize == 5 ? "selected" : "")>5</option>
                            <option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</option>
                            <option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</option>
                            <option value="50" @(Model.PageSize == 50 ? "selected" : "")>50</option>
                        </select>
                    </div>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <strong>Éxito:</strong> @TempData["SuccessMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card-body">
                    @using (Html.BeginForm("AsignarPaqueteACargaSJ", "PaquetesCargasController", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Número de Rastreo</th>
                                        <th>Emisor</th>
                                        <th>Receptor</th>
                                        <th>Estado</th>
                                        <th>Asignar a Carga</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Paquetes.Count; i++)
                                    {
                                        var paquete = Model.Paquetes[i];
                                        <tr>
                                            <td><span class="badge" style="background-color: var(--bg-info); color: white;">@paquete.NumeroRastreo</span></td>
                                            <td>@paquete.NombreEmisor</td>
                                            <td>@paquete.NombreReceptor</td>
                                            <td><span class="badge" style="background-color: var(--bg-info);">@paquete.Estado.ToString()</span></td>
                                            <td>
                                                @Html.Hidden($"PaqueteCargaAsignaciones[{i}].IdPaquete", paquete.Id_Paquete)
                                                <select name="PaqueteCargaAsignaciones[@i].IdCarga" class="form-select form-select-sm">
                                                    <option value="">Seleccionar Carga</option>
                                                    @foreach (var carga in Model.Cargas)
                                                    {
                                                        <option value="@carga.Id_Carga">
                                                            Carga: @carga.Id_Carga - Camionero: @carga.Usuario.Nombre
                                                        </option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginacion Paquetes -->
                        <div class="card-footer">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <span>Mostrando @((Model.PaquetePageNumber - 1) * Model.PageSize + 1) a @Math.Min(Model.PaquetePageNumber * Model.PageSize, Model.PaqueteTotalCount) de @Model.PaqueteTotalCount registros</span>
                                </div>
                                <div class="col-md-6">
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-end mb-0">
                                            <li class="page-item @(Model.PaquetePageNumber == 1 ? "disabled" : "")">
                                                <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                    paquetePage = Model.PaquetePageNumber - 1,
                                                    cargaPage = Model.CargaPageNumber,
                                                    cargaRecibidaPage = Model.CargaRecibidaPageNumber,
                                                    pageSize = Model.PageSize
                                                })">Anterior</a>
                                            </li>

                                            @for (int i = 1; i <= Model.PaqueteTotalPages; i++)
                                            {
                                                <li class="page-item @(i == Model.PaquetePageNumber ? "active" : "")">
                                                    <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                        paquetePage = i,
                                                        cargaPage = Model.CargaPageNumber,
                                                        cargaRecibidaPage = Model.CargaRecibidaPageNumber,
                                                        pageSize = Model.PageSize
                                                    })">@i</a>
                                                </li>
                                            }

                                            <li class="page-item @(Model.PaquetePageNumber == Model.PaqueteTotalPages ? "disabled" : "")">
                                                <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                    paquetePage = Model.PaquetePageNumber + 1,
                                                    cargaPage = Model.CargaPageNumber,
                                                    cargaRecibidaPage = Model.CargaRecibidaPageNumber,
                                                    pageSize = Model.PageSize
                                                })">Siguiente</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <button type="submit" class="btn" style="background-color: var(--bg-positivo); color: white;">
                                <i class="fa fa-save me-2"></i>Asignar Carga
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-truck-loading me-2"></i>Cargas
                    </h3>
                    <a href="@Url.Action("Create", "Cargas")" class="btn" style="background-color: var(--bg-positivo); color: white;">
                        <i class="fas fa-plus me-2"></i>Agregar Carga
                    </a>
                </div>

                @if (TempData["ErrorMessageCarga"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessageCarga"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessageCarga"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <strong>Éxito:</strong> @TempData["SuccessMessageCarga"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Transportista</th>
                                    <th>Estado</th>
                                    <th>Paquetes</th>
                                    <th>Acciones</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var carga in Model.Cargas)
                                {
                                    <tr>
                                        <td><span class="badge" style="background-color: var(--bg-info); color: white;">@carga.Id_Carga</span></td>
                                        <td>@carga.Usuario.Nombre</td>
                                        <td><span class="badge" style="background-color: var(--bg-dark); color: white;">@carga.Estado.ToString()</span></td>
                                        <td>
                                            <span class="badge" style="background-color: var(--bg-info); color: white;">@carga.NumeroPaquetes</span>
                                            <a href="@Url.Action("CargaPaquetes", "PaquetesCargasController", new { idCarga = carga.Id_Carga })"
                                               class="btn btn-sm btn-outline-primary ms-2">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="@Url.Action("Edit", "Cargas", new { id = carga.Id_Carga })"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", "Cargas", new { id = carga.Id_Carga })"
                                                   class="btn btn-sm" style="background-color: var(--bg-negativo); color: white;">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td>
                                            @using (Html.BeginForm("ActualizarEstadoCargaSJ", "PaquetesCargasController", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("idCarga", carga.Id_Carga)
                                                <div class="input-group input-group-sm">
                                                    <select name="nuevoEstado" class="form-select">
                                                        <option value="">Estado</option>
                                                        <option value="EnTransito">EnTransito</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-secondary">
                                                        <i class="fa fa-sync-alt"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginacion Cargas -->
                    <div class="card-footer">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span>Mostrando @((Model.CargaPageNumber - 1) * Model.PageSize + 1) a @Math.Min(Model.CargaPageNumber * Model.PageSize, Model.CargaTotalCount) de @Model.CargaTotalCount registros</span>
                            </div>
                            <div class="col-md-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-end mb-0">
                                        <li class="page-item @(Model.CargaPageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                cargaPage = Model.CargaPageNumber - 1,
                                                paquetePage = Model.PaquetePageNumber,
                                                cargaRecibidaPage = Model.CargaRecibidaPageNumber,
                                                pageSize = Model.PageSize
                                            })">Anterior</a>
                                        </li>

                                        @for (int i = 1; i <= Model.CargaTotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CargaPageNumber ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                    cargaPage = i,
                                                    paquetePage = Model.PaquetePageNumber,
                                                    cargaRecibidaPage = Model.CargaRecibidaPageNumber,
                                                    pageSize = Model.PageSize
                                                })">@i</a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.CargaPageNumber == Model.CargaTotalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                cargaPage = Model.CargaPageNumber + 1,
                                                paquetePage = Model.PaquetePageNumber,
                                                cargaRecibidaPage = Model.CargaRecibidaPageNumber,
                                                pageSize = Model.PageSize
                                            })">Siguiente</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-check-circle me-2"></i>Cargas Recibidas
                    </h3>
                </div>

                @if (TempData["ErrorMessageReceptor"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <strong>Error:</strong> @TempData["ErrorMessageReceptor"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessageReceptor"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <strong>Éxito:</strong> @TempData["SuccessMessageReceptor"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Transportista</th>
                                    <th>Estado</th>
                                    <th>Paquetes</th>
                                    <th>Ver</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var carga in Model.CargasRecibidas)
                                {
                                    <tr>
                                        <td><span class="badge" style="background-color: var(--bg-positivo); color: white;">@carga.Id_Carga</span></td>
                                        <td>@carga.Usuario.Nombre</td>
                                        <td><span class="badge" style="background-color: var(--bg-dark); color: white;">@carga.Estado.ToString()</span></td>
                                        <td><span class="badge bg-secondary">@carga.NumeroPaquetes</span></td>
                                        <td>
                                            <a href="@Url.Action("CargaPaquetesView", "PaquetesCargasController", new { idCarga = carga.Id_Carga })"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        </td>
                                        <td>
                                            @using (Html.BeginForm("EstadoCargaSJ", "PaquetesCargasController", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("idCarga", carga.Id_Carga)
                                                <div class="input-group input-group-sm">
                                                    <select name="nuevoEstado" class="form-select">
                                                        <option value="">Estado</option>
                                                        <option value="EnTransito">En Transito</option>
                                                        <option value="Recibido">Recibido</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-secondary">
                                                        <i class="fa fa-sync-alt"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginacion Cargas Recibidas -->
                    <div class="card-footer">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span>Mostrando @((Model.CargaRecibidaPageNumber - 1) * Model.PageSize + 1) a @Math.Min(Model.CargaRecibidaPageNumber * Model.PageSize, Model.CargaRecibidaTotalCount) de @Model.CargaRecibidaTotalCount registros</span>
                            </div>
                            <div class="col-md-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-end mb-0">
                                        <li class="page-item @(Model.CargaRecibidaPageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                cargaRecibidaPage = Model.CargaRecibidaPageNumber - 1,
                                                paquetePage = Model.PaquetePageNumber,
                                                cargaPage = Model.CargaPageNumber,
                                                pageSize = Model.PageSize
                                            })">Anterior</a>
                                        </li>

                                        @for (int i = 1; i <= Model.CargaRecibidaTotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CargaRecibidaPageNumber ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                    cargaRecibidaPage = i,
                                                    paquetePage = Model.PaquetePageNumber,
                                                    cargaPage = Model.CargaPageNumber,
                                                    pageSize = Model.PageSize
                                                })">@i</a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.CargaRecibidaPageNumber == Model.CargaRecibidaTotalPages ? "disabled" : "")">
                                            <a class="page-link" href="@Url.Action("AsignarPaqueteSJCarga", new {
                                                cargaRecibidaPage = Model.CargaRecibidaPageNumber + 1,
                                                paquetePage = Model.PaquetePageNumber,
                                                cargaPage = Model.CargaPageNumber,
                                                pageSize = Model.PageSize
                                            })">Siguiente</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changePageSize(size) {
        window.location.href = '@Url.Action("AsignarPaqueteSJCarga")' +
            '?paquetePage=@Model.PaquetePageNumber' +
            '&cargaPage=@Model.CargaPageNumber' +
            '&cargaRecibidaPage=@Model.CargaRecibidaPageNumber' +
            '&pageSize=' + size;
    }
</script>